# Fixed-timestep catch-up arithmetic (#13) — sim_catchup in src/game.eigs.
# The main loop's pacing depends on these invariants: one step per frame at
# 60 fps, catch-up on slow frames, stall clamp + substep cap + debt drop.

load_file of "src/game.eigs"

STEP is 1000.0 / 60.0
fails is 0

define check(label, ok) as:
    if ok == 1:
        print of f"  ok: {label}"
    else:
        print of f"  FAIL: {label}"
        fails is fails + 1

# Steady 60 fps: exactly one substep per frame, no drift
accum is 0.0
steps_total is 0
for f in range of 60:
    r is sim_catchup of [accum, STEP, STEP, 5, 250.0]
    steps_total is steps_total + r[0]
    accum is r[1]
check of ["60fps: 60 steps over 60 frames", steps_total == 60]

# 40 fps (25 ms frames): sim keeps wall-clock rate — 18 steps over 300 ms
accum is 0.0
steps_total is 0
for f in range of 12:
    r is sim_catchup of [accum, 25.0, STEP, 5, 250.0]
    steps_total is steps_total + r[0]
    accum is r[1]
# 300ms of wall time = 18 sim steps; float boundary effects may defer one
# step to the next frame (the fractional debt carries — never lost).
check of ["40fps: 17-18 steps over 12 frames (300ms)", (steps_total == 17) or (steps_total == 18)]

# 144 fps (6.944 ms frames): ~25 steps over 60 frames (416.7 ms)
accum is 0.0
steps_total is 0
for f in range of 60:
    r is sim_catchup of [accum, 1000.0 / 144.0, STEP, 5, 250.0]
    steps_total is steps_total + r[0]
    accum is r[1]
check of ["144fps: 24-25 steps over 60 frames", (steps_total == 24) or (steps_total == 25)]

# Stall: clamped to 250 ms, capped at 5 substeps, debt dropped
r is sim_catchup of [0.0, 5000.0, STEP, 5, 250.0]
check of ["stall: capped at 5 substeps", r[0] == 5]
check of ["stall: remaining debt dropped", r[1] < STEP]

# Sub-cap catch-up preserves the fractional remainder
r is sim_catchup of [0.0, 40.0, STEP, 5, 250.0]
check of ["catch-up: 2 steps from 40ms", r[0] == 2]
check of ["catch-up: remainder carried", (r[1] > 6.6) and (r[1] < 6.7)]

# Degenerate elapsed: zero and negative advance nothing
r is sim_catchup of [10.0, 0.0, STEP, 5, 250.0]
check of ["zero elapsed: no steps, accum kept", (r[0] == 0) and (r[1] == 10.0)]
r is sim_catchup of [10.0, 0.0 - 50.0, STEP, 5, 250.0]
check of ["negative elapsed: treated as zero", (r[0] == 0) and (r[1] == 10.0)]

if fails == 0:
    print of "All pacing tests passed"
else:
    print of f"{fails} pacing tests FAILED"
