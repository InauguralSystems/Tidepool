    sep is ui.separator of ["hud_sep", 0, 0, WINDOW_W, 0]
    sep.color is [60, 80, 120]
    ui.add_child of [hud, sep]

    # Energy section
    energy_lbl is ui.label of ["hud_energy_lbl", 10, 5, "ENERGY"]
    energy_lbl.color is [120, 120, 140]
    energy_lbl.scale is 1
    ui.add_child of [hud, energy_lbl]

    energy_bar is ui.progress_bar of ["hud_energy_bar", 10, 16, 200, 0.5]
    ui.add_child of [hud, energy_bar]

    energy_val is ui.label of ["hud_energy_val", 10, 32, "100"]
    energy_val.color is [50, 200, 50]
    energy_val.scale is 2
    ui.add_child of [hud, energy_val]

    # Score badge
    score_badge is ui.badge of ["hud_score", 230, 8, "Score: 0", [60, 60, 90]]
    ui.add_child of [hud, score_badge]

    # DNA badge
    dna_badge is ui.badge of ["hud_dna", 230, 30, "DNA: 0", [30, 60, 80]]
    ui.add_child of [hud, dna_badge]

    # Tier badge
    tier_badge is ui.badge of ["hud_tier", 380, 8, "Tier 0", [80, 60, 20]]
    ui.add_child of [hud, tier_badge]

    # Food counter
    food_badge is ui.badge of ["hud_food", 380, 30, "Food: 0", [20, 60, 20]]
    ui.add_child of [hud, food_badge]

    # Upgrade buttons
    spd_btn is ui.button of ["hud_spd", 520, 5, 80, 22, "Spd [5]", null]
    ui.add_child of [hud, spd_btn]

    sns_btn is ui.button of ["hud_sns", 520, 30, 80, 22, "Sns [5]", null]
    ui.add_child of [hud, sns_btn]

    spk_btn is ui.button of ["hud_spk", 620, 5, 80, 22, "Spk [5]", null]
    ui.add_child of [hud, spk_btn]

    # Upgrade levels display
    lvl_lbl is ui.label of ["hud_lvl", 620, 32, "S:0 N:0 K:0"]
    lvl_lbl.color is [160, 160, 180]
    lvl_lbl.scale is 1
    ui.add_child of [hud, lvl_lbl]

    # Alignment bar
    align_lbl is ui.label of ["hud_align_lbl", 720, 5, "ALIGN"]
    align_lbl.color is [120, 120, 140]
    align_lbl.scale is 1
    ui.add_child of [hud, align_lbl]

    align_bar is ui.progress_bar of ["hud_align", 720, 16, 60, 0.5]
    ui.add_child of [hud, align_bar]

    # Message line
    msg_lbl is ui.label of ["hud_msg", 10, 48, ""]
    msg_lbl.color is [255, 255, 100]
    msg_lbl.scale is 2
    ui.add_child of [hud, msg_lbl]

    return hud

# ============================================================
# Build all UI overlays
# ============================================================

diet_overlay is build_diet_overlay of null
pause_overlay is build_pause_overlay of null
gameover_overlay is build_gameover_overlay of null
hud_panel is build_hud_panel of null

# ============================================================
# HUD update — sync widget values from game state each frame
# ============================================================

define update_hud(g) as:
    # Energy bar
    energy_bar is ui.find_by_id of [hud_panel, "hud_energy_bar"]
    if energy_bar != null:
        if g.energy > 0:
            energy_bar.value is g.energy / 100.0
        else:
            energy_bar.value is 0
    energy_val is ui.find_by_id of [hud_panel, "hud_energy_val"]
    if energy_val != null:
        energy_val.text is f"{floor of g.energy}"
        if g.energy < 30:
            energy_val.color is [220, 60, 60]
        elif g.energy < 60:
            energy_val.color is [220, 180, 40]
        else:
            energy_val.color is [50, 200, 50]

    # Score
    score_w is ui.find_by_id of [hud_panel, "hud_score"]
    if score_w != null:
        score_w.text is f"Score: {g.score}"

    # DNA (show mate threshold)
    dna_w is ui.find_by_id of [hud_panel, "hud_dna"]
    if dna_w != null:
        threshold is mate_dna_threshold of g
        dna_w.text is f"DNA: {g.dna}/{threshold}"

    # Tier
    tier_w is ui.find_by_id of [hud_panel, "hud_tier"]
    if tier_w != null:
        tier_w.text is f"Tier {g.scale_tier}"

    # Food
    food_w is ui.find_by_id of [hud_panel, "hud_food"]
    if food_w != null:
        food_w.text is f"Food: {g.food_eaten}"

    # Upgrade button labels with cost and level
    spd_w is ui.find_by_id of [hud_panel, "hud_spd"]
    if spd_w != null:
        spd_w.label is f"Spd {g.speed_level} [5]"
        if g.dna < 5:
            spd_w.enabled is 0
        else:
            spd_w.enabled is 1

    sns_w is ui.find_by_id of [hud_panel, "hud_sns"]
    if sns_w != null:
        sns_w.label is f"Sns {g.sense_level} [5]"
        if g.dna < 5:
            sns_w.enabled is 0
        else:
            sns_w.enabled is 1

    spk_w is ui.find_by_id of [hud_panel, "hud_spk"]
    if spk_w != null:
        spk_w.label is f"Spk {g.spikes_level} [5]"
        if g.dna < 5:
            spk_w.enabled is 0
        else:
            spk_w.enabled is 1

    # Upgrade level display
    lvl_w is ui.find_by_id of [hud_panel, "hud_lvl"]
    if lvl_w != null:
        lvl_w.text is f"S:{g.speed_level} N:{g.sense_level} K:{g.spikes_level}"

    # Alignment bar — 0.0 = full herbivore (green), 1.0 = full carnivore (red)
    total_eaten is g.plants_eaten + g.meat_eaten
    if total_eaten > 0:
        align_val is g.meat_eaten / total_eaten
    else:
        align_val is 0.5
    align_w is ui.find_by_id of [hud_panel, "hud_align"]
    if align_w != null:
        align_w.value is align_val

    # Message line
    msg_w is ui.find_by_id of [hud_panel, "hud_msg"]
    if msg_w != null:
        msg_w.text is g.message

# ============================================================
# Update game over overlay with final stats
# ============================================================

define update_gameover_overlay(g) as:
    reason_w is ui.find_by_id of [gameover_overlay, "go_reason"]
    if reason_w != null:
        if g.game_over_reason == GAME_OVER_STARVED:
            reason_w.text is "You starved to death..."
        elif g.game_over_reason == GAME_OVER_CONSUMED:
            reason_w.text is "Consumed by a predator!"
        elif g.game_over_reason == GAME_OVER_EPIC:
            reason_w.text is "Devoured by a leviathan!"
        else:
            reason_w.text is "You perished."

    score_w is ui.find_by_id of [gameover_overlay, "go_score"]
    if score_w != null:
        score_w.text is f"Score: {g.score}"

    hi_w is ui.find_by_id of [gameover_overlay, "go_hiscore"]
    if hi_w != null:
        hi_w.text is f"Best: {high_score}"

    food_w is ui.find_by_id of [gameover_overlay, "go_food"]
    if food_w != null:
        food_w.text is f"Plants: {g.plants_eaten}"

    meat_w is ui.find_by_id of [gameover_overlay, "go_meat"]
    if meat_w != null:
        meat_w.text is f"Meat: {g.meat_eaten}"

    tier_w is ui.find_by_id of [gameover_overlay, "go_tier"]
    if tier_w != null:
        tier_w.text is f"Tier: {g.scale_tier}"

    dna_w is ui.find_by_id of [gameover_overlay, "go_dna"]
    if dna_w != null:
        dna_w.text is f"DNA: {g.dna}"

    upgrades_w is ui.find_by_id of [gameover_overlay, "go_upgrades"]
    if upgrades_w != null:
        upgrades_w.text is f"S:{g.speed_level} N:{g.sense_level} K:{g.spikes_level}"

    time_w is ui.find_by_id of [gameover_overlay, "go_time"]
    if time_w != null:
        secs is floor of (g.tick / 60)
        time_w.text is f"Time: {secs}s"

    newbest_w is ui.find_by_id of [gameover_overlay, "go_newbest"]
    if newbest_w != null:
        if g.score >= high_score and g.score > 0:
            newbest_w.text is "NEW HIGH SCORE!"
            newbest_w.x is floor of ((420 - 15 * 18) / 2)
        else:
            newbest_w.text is ""

# ============================================================
# Start a new game with the chosen diet
# ============================================================

define start_game(diet_choice) as:
    game is new_game of [60.0, 30.0, random_int of [1, 99999]]
    # Apply diet choice (0 = herbivore, 1 = carnivore)
    if diet_choice == 1:
        game.creature.mouth_type is MOUTH_JAW
        game.creature.palette is 1
        game.creature.appendages[0] is APPENDAGE_CLAW
        game.creature.appendages[1] is APPENDAGE_CLAW
        game.creature.appendages[2] is APPENDAGE_FIN
        game.creature.appendages[3] is APPENDAGE_FIN
        game.creature.spikes[0] is 1
        game.creature.spikes[1] is 1
        game.speed_level is 1
        game.alignment is 1
    else:
        game.creature.mouth_type is MOUTH_FILTER
        game.creature.palette is 0
        game.creature.appendages[0] is APPENDAGE_FIN
        game.creature.appendages[1] is APPENDAGE_FIN
        game.creature.appendages[2] is APPENDAGE_CILIA
        game.creature.appendages[3] is APPENDAGE_CILIA
        game.alignment is -1
    # Load saved creature if available
    load_creature of game.creature
    prev_tier is game.scale_tier
    tutorial_shown is 0
    keys_held.thrust is 0
    keys_held.brake is 0
    keys_held.left is 0
    keys_held.right is 0
    return game

# ============================================================
# Toast rendering — lightweight in-game notifications
# ============================================================

define draw_toast(text, timer, screen_w) as:
    if timer <= 0:
        return null
    # Fade: full for first 80%, then fade out
    alpha is 220
    if timer < 30:
        alpha is floor of (220 * timer / 30)
    tw is (len of text) * 12 + 16
    tx is floor of ((screen_w - tw) / 2)
    ty is 60
    draw_rrect of [tx, ty, tw, 28, 4, 30, 30, 50, alpha]
    if alpha > 80:
        draw_text of [tx + 8, ty + 6, text, 220, 220, 240, 2]

# ============================================================
# Tutorial overlay — shown during early gameplay
# ============================================================

define draw_tutorial(game, screen_w) as:
    if game.tick > 300:
        return null
    if game.food_eaten > 0:
        return null
    # Fade out toward tick 300
    alpha is 200
    remaining is 300 - game.tick
    if remaining < 60:
        alpha is floor of (200 * remaining / 60)
    tw is 380
    tx is floor of ((screen_w - tw) / 2)
    ty is 100
    draw_rrect of [tx, ty, tw, 80, 4, 20, 25, 45, alpha]
    if alpha > 60:
        draw_text of [tx + 12, ty + 10, "WASD or Arrow keys to move", 180, 200, 220, 2]
        draw_text of [tx + 12, ty + 32, "Eat green food to survive", 120, 200, 120, 2]
        draw_text of [tx + 12, ty + 54, "Avoid red predators!", 200, 120, 120, 2]

# ============================================================
# Check for click hits on UI panels (manual dispatch for buttons)
# ============================================================

define check_button_click(root, mx, my, btn_id) as:
    w is ui.find_by_id of [root, btn_id]
    if w == null:
        return 0
    if w.visible == 0:
        return 0
    # Walk up to find absolute position — for simplicity assume
    # buttons are nested one level deep inside a panel inside root.
    # We use the panel parent's position offset.
    # Actually, let's do a simple recursive hit test.
    return _hit_test_btn of [root, 0, 0, mx, my, btn_id]

define _hit_test_btn(widget, ox, oy, mx, my, btn_id) as:
    ax is ox + widget.x
    ay is oy + widget.y
    if widget.id == btn_id:
        if mx >= ax and mx < ax + widget.w and my >= ay and my < ay + widget.h:
            return 1
        return 0
    if widget.type == "panel" or widget.type == "hbox" or widget.type == "vbox":
        for i in range of (len of widget.children):
            result is _hit_test_btn of [widget.children[i], ax, ay, mx, my, btn_id]
            if result == 1:
                return 1
    return 0

# ============================================================
# Main game loop
# ============================================================

loop while running == 1:
    # Process all pending events
    ev is gfx_poll of null
    loop while ev != null:
        match ev.type:
            case "quit":
                running is 0
            case "keydown":
                if game_state == STATE_PLAYING:
                    match ev.key:
                        case "w":
                            keys_held.thrust is 1
                        case "up":
                            keys_held.thrust is 1
                        case "s":
                            keys_held.brake is 1
                        case "down":
                            keys_held.brake is 1
                        case "a":
                            keys_held.left is 1
                        case "left":
                            keys_held.left is 1
                        case "d":
                            keys_held.right is 1
                        case "right":
                            keys_held.right is 1
                        case "1":
                            game_action of [game, ACTION_BUY_SPEED]
                        case "2":
                            game_action of [game, ACTION_BUY_SENSE]
                        case "3":
                            game_action of [game, ACTION_BUY_SPIKES]
                        case "j":
                            game_action of [game, ACTION_JET]
                        case "p":
                            game_action of [game, ACTION_POISON]
                        case "e":
                            # If eligible (enough food eaten), evolve; else editor
                            if game.evolve_ready == 1:
                                game_action of [game, ACTION_EVOLVE]
                                toast_text is f"EVOLVED! Now Tier {game.scale_tier}"
                                toast_timer is 120
                                prev_tier is game.scale_tier
                            else:
                                # Open creature editor
                                editor_open of [game.creature, WINDOW_W, WINDOW_H]
                                game_state is STATE_EDITOR
                        case "m":
                            game_action of [game, ACTION_CALL_MATE]
                        case "tab":
                            if watch_mode == 0:
                                watch_mode is 1
                                obs_stack is new_observation_stack of null
                                if neural != null:
                                    toast_text is "Watch mode: ON [neural]"
                                else:
                                    toast_text is "Watch mode: ON [autopilot]"
                                toast_timer is 90
                            else:
                                watch_mode is 0
                                game.thrusting is 0
                                game.braking is 0
                                game.turning is 0
                                toast_text is "Watch mode: OFF"
                                toast_timer is 90
                        case "escape":
                            game_state is STATE_PAUSED
                elif game_state == STATE_PAUSED:
                    if ev.key == "escape":
                        game_state is STATE_PLAYING
                elif game_state == STATE_GAME_OVER:
                    if ev.key == "escape":
                        game_state is STATE_DIET_CHOICE
                        game is null
                    if ev.key == "return":
                        game is start_game of 0
                        game_state is STATE_PLAYING
                elif game_state == STATE_EDITOR:
                    if ev.key == "escape":
                        editor_close of null
                        game_state is STATE_PLAYING
                    elif ev.key == "p":
                        save_creature of game.creature
                        toast_text is "Creature saved"
                        toast_timer is 90
                    elif ev.key == "o":
                        if (load_creature of game.creature) == 1:
                            toast_text is "Creature loaded"
                            toast_timer is 90
                        else:
                            toast_text is "No saved creature"
                            toast_timer is 90
                elif game_state == STATE_DIET_CHOICE:
                    if ev.key == "escape":
                        running is 0
            case "keyup":
                if game_state == STATE_PLAYING:
                    match ev.key:
                        case "w":
                            keys_held.thrust is 0
                        case "up":
                            keys_held.thrust is 0
                        case "s":
                            keys_held.brake is 0
                        case "down":
                            keys_held.brake is 0
                        case "a":
                            keys_held.left is 0
                        case "left":
                            keys_held.left is 0
                        case "d":
                            keys_held.right is 0
                        case "right":
                            keys_held.right is 0
            case "mousedown":
                mx is ev.x
                my is ev.y
                if game_state == STATE_DIET_CHOICE:
                    if (check_button_click of [diet_overlay, mx, my, "herb_btn"]) == 1:
                        watch_diet is 0
                        game is start_game of 0
                        game_state is STATE_PLAYING
                    elif (check_button_click of [diet_overlay, mx, my, "carn_btn"]) == 1:
                        watch_diet is 1
                        game is start_game of 1
                        game_state is STATE_PLAYING
                elif game_state == STATE_PAUSED:
                    if (check_button_click of [pause_overlay, mx, my, "resume_btn"]) == 1:
                        game_state is STATE_PLAYING
                    elif (check_button_click of [pause_overlay, mx, my, "editor_btn"]) == 1:
                        editor_open of [game.creature, WINDOW_W, WINDOW_H]
                        game_state is STATE_EDITOR
                    elif (check_button_click of [pause_overlay, mx, my, "restart_btn"]) == 1:
                        game_state is STATE_DIET_CHOICE
                        game is null
                    elif (check_button_click of [pause_overlay, mx, my, "quit_btn"]) == 1:
                        running is 0
                elif game_state == STATE_GAME_OVER:
                    if (check_button_click of [gameover_overlay, mx, my, "go_restart_btn"]) == 1:
                        game_state is STATE_DIET_CHOICE
                    elif (check_button_click of [gameover_overlay, mx, my, "go_quit_btn"]) == 1:
                        running is 0
                elif game_state == STATE_EDITOR:
                    if _editor_root != null:
                        # Check Done/Cancel
                        if (check_button_click of [_editor_root, mx, my, "ed_done"]) == 1:
                            editor_apply_to_spec of game.creature
                            editor_close of null
                            game_state is STATE_PLAYING
                        elif (check_button_click of [_editor_root, mx, my, "ed_cancel"]) == 1:
                            editor_close of null
                            game_state is STATE_PLAYING
                        else:
                            # Check part buttons
                            for pi in range of 8:
                                if (check_button_click of [_editor_root, mx, my, f"ed_part_{pi}"]) == 1:
                                    editor_handle_part_click of [pi, _editor_spec, game]
                            # Let UI dispatch handle dropdowns/spinboxes
                            ui.dispatch of [_editor_root, ev]
                elif game_state == STATE_PLAYING:
                    # HUD button clicks
                    if (check_button_click of [hud_panel, mx, my, "hud_spd"]) == 1:
                        game_action of [game, ACTION_BUY_SPEED]
                    elif (check_button_click of [hud_panel, mx, my, "hud_sns"]) == 1:
                        game_action of [game, ACTION_BUY_SENSE]
                    elif (check_button_click of [hud_panel, mx, my, "hud_spk"]) == 1:
                        game_action of [game, ACTION_BUY_SPIKES]
            case "mousemotion":
                # Update button hover states for whichever overlay is active
                mx is ev.x
                my is ev.y
                if game_state == STATE_EDITOR:
                    if _editor_root != null:
                        ui.dispatch of [_editor_root, ev]
                elif game_state == STATE_DIET_CHOICE:
                    ui.dispatch of [diet_overlay, ev]
                elif game_state == STATE_PAUSED:
                    ui.dispatch of [pause_overlay, ev]
                elif game_state == STATE_GAME_OVER:
                    ui.dispatch of [gameover_overlay, ev]
                elif game_state == STATE_PLAYING:
                    ui.dispatch of [hud_panel, ev]
        ev is gfx_poll of null

    bg_tick is bg_tick + 1

    # ---- Update ----
    if game_state == STATE_PLAYING:
        if game != null:
            if watch_mode == 1:
                if neural != null:
                    obs is build_observation of game
                    push_observation of [obs_stack, obs]
                    stacked is build_stacked_observation of [obs_stack, game]
                    policy_decide of [neural, stacked, game]
                else:
                    autopilot_decide of game
                # Log demo for training (autopilot decision as label)
                if game.game_over != 1:
                    demo_obs is build_observation of game
                    demo_act is autopilot_action_label of game
                    log_demo_frame of [demo_log, demo_obs, demo_act]
                    # Launch training when enough demos collected
                    if demo_log.count >= DEMO_THRESHOLD and (training_is_active of null) == 0:
                        launch_training of [demo_log, neural]
                        demo_log is new_demo_log of null
                        toast_text is f"Training on {DEMO_THRESHOLD} demos..."
                        toast_timer is 90
                # Check if background training finished
                result is check_training_done of null
                if result != null:
                    toast_text is f"Training: {result}"
                    toast_timer is 120
                    # Reload policy if training succeeded
                    reloaded is policy_to_buffers of (load_policy of null)
                    if reloaded != null:
                        neural is reloaded
                        toast_text is "New policy promoted!"
                        toast_timer is 120
            else:
                apply_held_keys of [game, keys_held]
            game_tick of game
            audio_game_update of game
            update_hud of game

            # Check for tier-up toast
            if game.scale_tier > prev_tier:
                toast_text is f"TIER UP! Now Tier {game.scale_tier}"
                toast_timer is 120
                prev_tier is game.scale_tier
                # Spawn tier-up particle burst
                for _ti in range of 15:
                    spawn_death_burst of [game.px, game.py, game.creature.palette]

            # Check for game over transition
            if game.game_over == 1:
                if watch_mode == 1:
                    # Auto-restart in watch mode
                    game is start_game of watch_diet
                    obs_stack is new_observation_stack of null
                    game_state is STATE_PLAYING
                else:
                    high_score is save_high_score of game.score
                    update_gameover_overlay of game
                    game_state is STATE_GAME_OVER

            # Decrement toast timer
            if toast_timer > 0:
                toast_timer is toast_timer - 1

    # ---- Render ----
    if game_state == STATE_DIET_CHOICE:
        render_ocean_bg of [WINDOW_W, WINDOW_H, bg_tick]
        ui.render of [diet_overlay, 0, 0]
        gfx_present of null

    elif game_state == STATE_PLAYING:
        if game != null:
            if watch_mode == 1:
                if neural != null:
                    gfx_title of "Tidepool [AI:neural]"
                else:
                    gfx_title of "Tidepool [AI:auto]"
            else:
                gfx_title of "Tidepool"
            try:
                render_world_only of [game, WINDOW_W, WINDOW_H]
                ui.render of [hud_panel, 0, 0]
                # Tutorial overlay
                draw_tutorial of [game, WINDOW_W]
                # Toast notifications
                draw_toast of [toast_text, toast_timer, WINDOW_W]
                gfx_present of null
            catch err:
                print of f"Render error: {err}"
                running is 0

    elif game_state == STATE_PAUSED:
        if game != null:
            render_world_only of [game, WINDOW_W, WINDOW_H]
            # Dim overlay
            draw_rect of [0, 0, WINDOW_W, WINDOW_H, 0, 0, 0, 140]
            ui.render of [pause_overlay, 0, 0]
            gfx_present of null

    elif game_state == STATE_EDITOR:
        draw_clear of [12, 18, 30]
        editor_render of [WINDOW_W, WINDOW_H]
        gfx_present of null

    elif game_state == STATE_GAME_OVER:
        if game != null:
            render_world_only of [game, WINDOW_W, WINDOW_H]
            # Dim overlay
            draw_rect of [0, 0, WINDOW_W, WINDOW_H, 0, 0, 0, 160]
            ui.render of [gameover_overlay, 0, 0]
            gfx_present of null

    # Frame timing
    gfx_delay of 1

audio_game_shutdown of null
gfx_close of null
if game != null:
    print of f"Game over: {game.message}"
    print of f"Score: {game.score} | Food: {game.food_eaten} | Tier: {game.scale_tier}"
else:
    print of "Thanks for playing Tidepool!"
