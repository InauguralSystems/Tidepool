# ============================================================
# Tidepool — Main Game
# ============================================================
# A Spore-inspired cell-stage evolution game in pure EigenScript.
#
# Controls:
#   Arrow keys  — thrust, turn, brake
#   1/2/3       — buy speed/sense/spikes (costs 5 DNA)
#   q           — quit

load_file of "src/game.eigs"
load_file of "src/renderer.eigs"

ESC is chr of 27

# Screen dimensions
SCREEN_W is 60
SCREEN_H is 20
FRAME_DELAY is 70000

# Hide cursor, clear screen
write of f"{ESC}[?25l{ESC}[2J"
flush of null

game is new_game of [60.0, 20.0, 42]

# Main loop
running is 1
loop while running == 1:
    # Non-blocking input
    key is raw_key of null

    # Reset movement
    game.thrusting is 0
    game.braking is 0
    game.turning is 0

    # Handle input
    match key:
        case "up":
            game is game_action of [game, ACTION_THRUST]
        case "down":
            game is game_action of [game, ACTION_BRAKE]
        case "left":
            game is game_action of [game, ACTION_TURN_LEFT]
        case "right":
            game is game_action of [game, ACTION_TURN_RIGHT]
        case "1":
            game is game_action of [game, ACTION_BUY_SPEED]
        case "2":
            game is game_action of [game, ACTION_BUY_SENSE]
        case "3":
            game is game_action of [game, ACTION_BUY_SPIKES]
        case "q":
            running is 0

    # Tick
    game is game_tick of game

    # Render
    render_game of [game, SCREEN_W, SCREEN_H]

    # Game over
    if game.game_over == 1:
        write of f"\n\n{ESC}[31m GAME OVER: {game.message}{ESC}[0m\n"
        write of f" Score: {game.score} | Food: {game.food_eaten} | Tier: {game.scale_tier}\n"
        flush of null
        running is 0

    usleep of FRAME_DELAY

# Cleanup
write of f"{ESC}[?25h{ESC}[0m\n"
flush of null
