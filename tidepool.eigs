# ============================================================
# Tidepool — A Spore-inspired cell-stage game in EigenScript
# ============================================================
#
# Controls:
#   W/Up     — thrust
#   S/Down   — brake
#   A/Left   — turn left
#   D/Right  — turn right
#   1        — buy speed (5 DNA)
#   2        — buy sense (5 DNA)
#   3        — buy spikes (5 DNA)
#   Escape   — quit

load_file of "src/game.eigs"
load_file of "src/renderer.eigs"

WINDOW_W is 800
WINDOW_H is 600

# Open window
result is gfx_open of [WINDOW_W, WINDOW_H, "Tidepool"]
running is 1
if result == 0:
    print of "Failed to open graphics window"
    running is 0

# Create game
game is new_game of [60.0, 30.0, 42]

# Input state (held keys)
keys_held is {
    "thrust": 0, "brake": 0,
    "left": 0, "right": 0
}

# Main game loop
loop while running == 1:
    # Process all pending events
    ev is gfx_poll of null
    loop while ev != null:
        match ev.type:
            case "quit":
                running is 0
            case "keydown":
                match ev.key:
                    case "w":
                        keys_held.thrust is 1
                    case "up":
                        keys_held.thrust is 1
                    case "s":
                        keys_held.brake is 1
                    case "down":
                        keys_held.brake is 1
                    case "a":
                        keys_held.left is 1
                    case "left":
                        keys_held.left is 1
                    case "d":
                        keys_held.right is 1
                    case "right":
                        keys_held.right is 1
                    case "1":
                        game_action of [game, ACTION_BUY_SPEED]
                    case "2":
                        game_action of [game, ACTION_BUY_SENSE]
                    case "3":
                        game_action of [game, ACTION_BUY_SPIKES]
                    case "escape":
                        running is 0
            case "keyup":
                match ev.key:
                    case "w":
                        keys_held.thrust is 0
                    case "up":
                        keys_held.thrust is 0
                    case "s":
                        keys_held.brake is 0
                    case "down":
                        keys_held.brake is 0
                    case "a":
                        keys_held.left is 0
                    case "left":
                        keys_held.left is 0
                    case "d":
                        keys_held.right is 0
                    case "right":
                        keys_held.right is 0
        ev is gfx_poll of null

    # Apply held keys to game
    game.thrusting is keys_held.thrust
    game.braking is keys_held.brake
    if keys_held.left == 1:
        game.turning is -1
    elif keys_held.right == 1:
        game.turning is 1
    else:
        game.turning is 0

    # Simulation tick — mutates `game` in place
    game_tick of game

    # Render
    try:
        render_game of [game, WINDOW_W, WINDOW_H]
    catch err:
        print of f"Render error: {err}"
        running is 0

    # Game over — restart
    if game.game_over == 1:
        gfx_clear of [80, 10, 10]
        gfx_present of null
        gfx_delay of 1500
        game is new_game of [60.0, 30.0, random_int of [1, 99999]]
        keys_held.thrust is 0
        keys_held.brake is 0
        keys_held.left is 0
        keys_held.right is 0

    # Frame timing (vsync handles most of it)
    gfx_delay of 1

gfx_close of null
print of f"Game over: {game.message}"
print of f"Score: {game.score} | Food: {game.food_eaten} | Tier: {game.scale_tier}"
