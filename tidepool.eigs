# ============================================================
# Tidepool — A Spore-inspired cell-stage game in EigenScript
# ============================================================
#
# Controls:
#   W/Up     — thrust
#   S/Down   — brake
#   A/Left   — turn left
#   D/Right  — turn right
#   1        — buy speed (5 DNA)
#   2        — buy sense (5 DNA)
#   3        — buy spikes (5 DNA)
#   Tab      — toggle watch mode (AI plays)
#   Escape   — pause (during play) / back
#
# Headless modes:
#   eigenscript tidepool.eigs --demo 500 --seed 42
#   eigenscript tidepool.eigs --demo 500 --seed 42 --batch 20

load_file of "src/game.eigs"
load_file of "src/neural.eigs"
load_file of "src/audio.eigs"
load_file of "src/training.eigs"

# ============================================================
# CLI argument parsing
# ============================================================

define parse_args() as:
    argv is args of null
    result is {"demo": -1, "seed": -1, "batch": 1}
    i is 0
    loop while i < (len of argv):
        match argv[i]:
            case "--demo":
                if i + 1 < (len of argv):
                    i is i + 1
                    result.demo is floor of (num of argv[i])
            case "--seed":
                if i + 1 < (len of argv):
                    i is i + 1
                    result.seed is floor of (num of argv[i])
            case "--batch":
                if i + 1 < (len of argv):
                    i is i + 1
                    result.batch is floor of (num of argv[i])
        i is i + 1
    return result

cli is parse_args of null

# ============================================================
# Headless demo mode
# ============================================================

if cli.demo >= 0:
    define run_demo_episode(ticks, seed_val) as:
        game is new_game of [60.0, 30.0, seed_val]
        for t in range of ticks:
            autopilot_decide of game
            game_tick of game
            if game.game_over == 1:
                break
        return {
            "score": game.score,
            "energy": game.energy,
            "food": game.food_eaten,
            "tier": game.scale_tier,
            "ticks": game.tick,
            "alive": 1 - game.game_over
        }

    base_seed is cli.seed
    if base_seed < 0:
        base_seed is random_int of [1, 99999]

    if cli.batch <= 1:
        # Single demo run
        r is run_demo_episode of [cli.demo, base_seed]
        print of f"seed={base_seed} ticks={r.ticks} score={r.score} energy={r.energy} food={r.food} tier={r.tier} alive={r.alive}"
    else:
        # Batch run with aggregate stats
        total_score is 0
        total_food is 0
        total_energy is 0
        total_ticks is 0
        survived is 0

        for ep in range of cli.batch:
            ep_seed is base_seed + ep
            r is run_demo_episode of [cli.demo, ep_seed]
            total_score is total_score + r.score
            total_food is total_food + r.food
            total_energy is total_energy + r.energy
            total_ticks is total_ticks + r.ticks
            survived is survived + r.alive

        n is cli.batch
        print of f"episodes={n} demo_ticks={cli.demo} seed={base_seed}"
        print of f"  survived: {survived}/{n}"
        print of f"  avg_score: {total_score / n}"
        print of f"  avg_food: {total_food / n}"
        print of f"  avg_energy: {total_energy / n}"
        print of f"  avg_ticks: {total_ticks / n}"

    # Exit without opening a window
    return null

# ============================================================
# Graphical mode — load renderer, editor, UI
# ============================================================

load_file of "src/renderer.eigs"
load_file of "src/editor.eigs"
import ui

WINDOW_W is 800
WINDOW_H is 600

# ============================================================
# Game states
# ============================================================
STATE_DIET_CHOICE is 0
STATE_PLAYING is 1
STATE_PAUSED is 2
STATE_GAME_OVER is 3
STATE_EDITOR is 4

# ============================================================
# Open window
# ============================================================
result is gfx_open of [WINDOW_W, WINDOW_H, "Tidepool"]
audio_game_init of null
audio_start_music of null
running is 1
if result == 0:
    print of "Failed to open graphics window"
    running is 0

# ============================================================
# Game state
# ============================================================
game is null
game_state is STATE_DIET_CHOICE
bg_tick is 0
prev_tier is 0
toast_text is ""
toast_timer is 0
tutorial_shown is 0
watch_mode is 0
watch_diet is 0
obs_stack is new_observation_stack of null
demo_log is new_demo_log of null
neural is policy_to_buffers of (load_policy of null)
if neural != null:
    print of "Neural policy loaded"

# High score
high_score is 0

define load_high_score() as:
    if file_exists of "saves/high_score.txt":
        text is read_text of "saves/high_score.txt"
        if (len of text) > 0:
            return num of text
    return 0

define save_high_score(score) as:
    existing is load_high_score of null
    if score > existing:
        mkdir of "saves"
        write_text of ["saves/high_score.txt", f"{score}"]
        return score
    return existing

high_score is load_high_score of null

# Input state (held keys)
keys_held is {
    "thrust": 0, "brake": 0,
    "left": 0, "right": 0
}

# ============================================================
# UI widget builders — called once per screen transition
# ============================================================

# ---- Diet choice overlay ----

define build_diet_overlay() as:
    root is ui.panel of ["diet_root", 0, 0, WINDOW_W, WINDOW_H]
    root.bg is null
    root.border is null

    # No full-screen scrim — let the atmospheric ocean background show through
    # so the menu reads as the same pool as the game. The choice panels carry
    # their own backdrops for text contrast.
    overlay_bg is ui.panel of ["diet_bg", 0, 0, WINDOW_W, WINDOW_H]
    overlay_bg.bg is null
    overlay_bg.border is null
    ui.add_child of [root, overlay_bg]

    # Title
    title is ui.label of ["diet_title", 0, 80, "CHOOSE YOUR PATH"]
    title.color is [220, 220, 240]
    title.scale is 4
    # Center: text is 16 chars * 6px * 4 scale = 384px, offset = (800 - 384) / 2 = 208
    title.x is 208
    ui.add_child of [root, title]

    subtitle is ui.label of ["diet_sub", 0, 130, "How will you survive the tidepool?"]
    subtitle.color is [120, 140, 160]
    subtitle.scale is 2
    subtitle.x is floor of ((WINDOW_W - 33 * 12) / 2)
    ui.add_child of [root, subtitle]

    # Herbivore panel
    herb_panel is ui.panel of ["herb_panel", 100, 180, 260, 260]
    herb_panel.bg is [20, 50, 30]
    herb_panel.border is [40, 140, 60]

    herb_title is ui.label of ["herb_title", 30, 20, "HERBIVORE"]
    herb_title.color is [80, 220, 80]
    herb_title.scale is 3
    ui.add_child of [herb_panel, herb_title]

    herb_icon is ui.label of ["herb_icon", 100, 60, "( o )"]
    herb_icon.color is [60, 200, 60]
    herb_icon.scale is 3
    ui.add_child of [herb_panel, herb_icon]

    herb_d1 is ui.label of ["herb_d1", 20, 120, "Filter-feed on plants"]
    herb_d1.color is [140, 200, 140]
    herb_d1.scale is 2
    ui.add_child of [herb_panel, herb_d1]

    herb_d2 is ui.label of ["herb_d2", 20, 145, "Peaceful but cautious"]
    herb_d2.color is [120, 170, 120]
    herb_d2.scale is 2
    ui.add_child of [herb_panel, herb_d2]

    herb_d3 is ui.label of ["herb_d3", 20, 170, "Abundant food sources"]
    herb_d3.color is [120, 170, 120]
    herb_d3.scale is 2
    ui.add_child of [herb_panel, herb_d3]

    herb_btn is ui.button of ["herb_btn", 55, 210, 150, 32, "Choose", null]
    ui.add_child of [herb_panel, herb_btn]

    ui.add_child of [root, herb_panel]

    # Carnivore panel
    carn_panel is ui.panel of ["carn_panel", 440, 180, 260, 260]
    carn_panel.bg is [50, 20, 20]
    carn_panel.border is [180, 50, 50]

    carn_title is ui.label of ["carn_title", 25, 20, "CARNIVORE"]
    carn_title.color is [220, 80, 80]
    carn_title.scale is 3
    ui.add_child of [carn_panel, carn_title]

    carn_icon is ui.label of ["carn_icon", 95, 60, "< X >"]
    carn_icon.color is [200, 60, 60]
    carn_icon.scale is 3
    ui.add_child of [carn_panel, carn_icon]

    carn_d1 is ui.label of ["carn_d1", 20, 120, "Hunt and consume prey"]
    carn_d1.color is [200, 140, 140]
    carn_d1.scale is 2
    ui.add_child of [carn_panel, carn_d1]

    carn_d2 is ui.label of ["carn_d2", 20, 145, "Aggressive and fast"]
    carn_d2.color is [170, 120, 120]
    carn_d2.scale is 2
    ui.add_child of [carn_panel, carn_d2]

    carn_d3 is ui.label of ["carn_d3", 20, 170, "High-risk, high-reward"]
    carn_d3.color is [170, 120, 120]
    carn_d3.scale is 2
    ui.add_child of [carn_panel, carn_d3]

    carn_btn is ui.button of ["carn_btn", 55, 210, 150, 32, "Choose", null]
    ui.add_child of [carn_panel, carn_btn]

    ui.add_child of [root, carn_panel]

    # Hint text
    hint is ui.label of ["diet_hint", 0, 480, "Click a path to begin your journey"]
    hint.color is [100, 110, 130]
    hint.scale is 2
    hint.x is floor of ((WINDOW_W - 34 * 12) / 2)
    ui.add_child of [root, hint]

    return root

# ---- Pause overlay ----

define build_pause_overlay() as:
    root is ui.panel of ["pause_root", 0, 0, WINDOW_W, WINDOW_H]
    root.bg is null
    root.border is null

    # Center box
    bw is 300
    bh is 310
    bx is floor of ((WINDOW_W - bw) / 2)
    by is floor of ((WINDOW_H - bh) / 2)

    box is ui.panel of ["pause_box", bx, by, bw, bh]
    box.bg is [25, 25, 40]
    box.border is [60, 80, 120]

    title is ui.label of ["pause_title", 0, 20, "PAUSED"]
    title.color is [200, 200, 230]
    title.scale is 4
    # Center: 6 chars * 6px * 4 = 144, offset = (300 - 144) / 2 = 78
    title.x is 78
    ui.add_child of [box, title]

    sep is ui.separator of ["pause_sep", 20, 70, 260, 0]
    ui.add_child of [box, sep]

    resume_btn is ui.button of ["resume_btn", 75, 90, 150, 36, "Resume", null]
    ui.add_child of [box, resume_btn]

    editor_btn is ui.button of ["editor_btn", 75, 140, 150, 36, "Editor", null]
    ui.add_child of [box, editor_btn]

    restart_btn is ui.button of ["restart_btn", 75, 190, 150, 36, "Restart", null]
    ui.add_child of [box, restart_btn]

    quit_btn is ui.button of ["quit_btn", 75, 240, 150, 36, "Quit", null]
    ui.add_child of [box, quit_btn]

    ui.add_child of [root, box]
    return root

