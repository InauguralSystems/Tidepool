    ui.add_child of [box, score_lbl]

    hi_lbl is ui.label of ["go_hiscore", 30, 124, "Best: 0"]
    hi_lbl.color is [255, 220, 100]
    hi_lbl.scale is 2
    ui.add_child of [box, hi_lbl]

    tier_lbl is ui.label of ["go_tier", 30, 152, "Tier: 0"]
    tier_lbl.color is [255, 200, 50]
    tier_lbl.scale is 2
    ui.add_child of [box, tier_lbl]

    dna_lbl is ui.label of ["go_dna", 30, 176, "DNA: 0"]
    dna_lbl.color is [100, 200, 255]
