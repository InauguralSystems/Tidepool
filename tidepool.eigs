    bw is 420
    bh is 400
    bx is floor of ((WINDOW_W - bw) / 2)
    by is floor of ((WINDOW_H - bh) / 2)

    box is ui.panel of ["go_box", bx, by, bw, bh]
    box.bg is [40, 15, 15]
    box.border is [140, 40, 40]

    title is ui.label of ["go_title", 0, 15, "GAME OVER"]
    title.color is [220, 60, 60]
    title.scale is 4
    title.x is floor of ((bw - 9 * 24) / 2)
    ui.add_child of [box, title]

    sep is ui.separator of ["go_sep", 20, 58, bw - 40, 0]
    ui.add_child of [box, sep]

    reason is ui.label of ["go_reason", 30, 72, ""]
    reason.color is [200, 160, 160]
