# ============================================================
# Tidepool DQN Training — pure EigenScript, no Python needed
# ============================================================
#
# Usage:
#   eigenscript train.eigs --episodes 1000 --seed 42
#   eigenscript train.eigs --episodes 5000 --lr 0.001

load_file of "src/game.eigs"
load_file of "src/neural.eigs"

# ============================================================
# Training hyperparameters
# ============================================================

define parse_train_args() as:
    argv is args of null
    result is {
        "episodes": 1000,
        "seed": -1,
        "lr": 0.001,
        "gamma": 0.99,
        "epsilon_start": 1.0,
        "epsilon_end": 0.05,
        "epsilon_decay": 0.9995,
        "batch_size": 32,
        "buffer_size": 5000,
        "target_update": 100,
        "tick_limit": 1000,
        "resume": 0,
        "eps_start_override": -1.0
    }
    i is 0
    loop while i < (len of argv):
        if argv[i] == "--episodes":
            if i + 1 < (len of argv):
                i is i + 1
                result.episodes is floor of (num of argv[i])
        elif argv[i] == "--seed":
            if i + 1 < (len of argv):
                i is i + 1
                result.seed is floor of (num of argv[i])
        elif argv[i] == "--lr":
            if i + 1 < (len of argv):
                i is i + 1
                result.lr is num of argv[i]
        elif argv[i] == "--batch":
            if i + 1 < (len of argv):
                i is i + 1
                result.batch_size is floor of (num of argv[i])
        elif argv[i] == "--buffer":
            if i + 1 < (len of argv):
                i is i + 1
                result.buffer_size is floor of (num of argv[i])
        elif argv[i] == "--ticks" or argv[i] == "--steps":
            if i + 1 < (len of argv):
                i is i + 1
                result.tick_limit is floor of (num of argv[i])
        elif argv[i] == "--target-update":
            if i + 1 < (len of argv):
                i is i + 1
                result.target_update is floor of (num of argv[i])
        elif argv[i] == "--resume":
            result.resume is 1
        elif argv[i] == "--eps-start":
            if i + 1 < (len of argv):
                i is i + 1
                result.eps_start_override is num of argv[i]
        i is i + 1
    return result

hp is parse_train_args of null
if hp.seed >= 0:
    seed_random of hp.seed

# When resuming an already-trained checkpoint, don't blow it up with a full
# epsilon=1.0 random restart — start exploration low (or at --eps-start).
if hp.resume == 1 and hp.eps_start_override < 0.0:
    hp.epsilon_start is 0.5
if hp.eps_start_override >= 0.0:
    hp.epsilon_start is hp.eps_start_override

# Adaptive epsilon schedule: anneal from epsilon_start to epsilon_end over
# ~60% of training so the greedy policy is actually exploited and refined in
# the back third. Overrides the fixed default decay (which barely moved over
# a few hundred episodes and left the policy mostly random the whole run).
if hp.episodes > 1:
    anneal_eps is 0.6 * hp.episodes
    hp.epsilon_decay is pow of [(hp.epsilon_end / hp.epsilon_start), 1.0 / anneal_eps]

# ============================================================
# Transpose helper
# ============================================================

# Weights/activations are shaped flat buffers (row-major). transpose reads the
# 2-D shape and swaps indices into a new buffer.
define transpose(m) as:
    sh is shape of m
    rows is sh[0]
    cols is sh[1]
    result is buffer of [cols, rows]
    for r in range of rows:
        base is r * cols
        for c in range of cols:
            result[c * rows + r] is m[base + c]
    return result

# Stack a list of 1-D obs buffers into one [batch x cols] buffer so matmul takes
# the flat fast path (it needs a single shaped buffer, not a list of vectors).
define stack_obs(obs_list) as:
    bs is len of obs_list
    cols is len of obs_list[0]
    m is buffer of [bs, cols]
    for r in range of bs:
        row is obs_list[r]
        base is r * cols
        for c in range of cols:
            m[base + c] is row[c]
    return m

# z[r,c] = pre[r,c] + bias[c] — broadcast a 1-D bias over batch rows. The VM
# guards every '+', so this matches the `add` builtin's num_guard byte-for-byte.
define add_bias(pre, bias, rows, cols) as:
    out is buffer of [rows, cols]
    for r in range of rows:
        base is r * cols
        for c in range of cols:
            out[base + c] is pre[base + c] + bias[c]
    return out

# ============================================================
# Replay buffer (circular)
# ============================================================

define new_buffer(capacity) as:
    return {
        "obs": [],
        "actions": [],
        "rewards": [],
        "next_obs": [],
        "dones": [],
        "capacity": capacity,
        "pos": 0,
        "size": 0
    }

define buffer_add(buf, obs, action, reward, next_obs, done) as:
    if buf.size < buf.capacity:
        append of [buf.obs, obs]
        append of [buf.actions, action]
        append of [buf.rewards, reward]
        append of [buf.next_obs, next_obs]
        append of [buf.dones, done]
        buf.size is buf.size + 1
    else:
        buf.obs[buf.pos] is obs
        buf.actions[buf.pos] is action
        buf.rewards[buf.pos] is reward
        buf.next_obs[buf.pos] is next_obs
        buf.dones[buf.pos] is done
    buf.pos is (buf.pos + 1) % buf.capacity

define buffer_sample(buf, batch_size) as:
    obs is []
    actions is []
    rewards is []
    next_obs is []
    dones is []
    for i in range of batch_size:
        idx is random_int of [0, buf.size - 1]
        append of [obs, buf.obs[idx]]
        append of [actions, buf.actions[idx]]
        append of [rewards, buf.rewards[idx]]
        append of [next_obs, buf.next_obs[idx]]
        append of [dones, buf.dones[idx]]
    return [obs, actions, rewards, next_obs, dones]

# ============================================================
# Forward pass with cache (for backprop)
# ============================================================

define forward_cached(policy, obs_batch) as:
    # obs_batch: list of 1-D obs buffers -> a [bs x input] buffer, then the
    # forward runs all-buffer (matmul/relu fast path, add_bias broadcast).
    x is stack_obs of obs_batch
    bs is len of obs_batch
    z1 is add_bias of [(matmul of [x, policy.w1]), policy.b1, bs, NEURAL_HIDDEN1]
    a1 is relu of z1
    z2 is add_bias of [(matmul of [a1, policy.w2]), policy.b2, bs, NEURAL_HIDDEN2]
    a2 is relu of z2
    q is add_bias of [(matmul of [a2, policy.w3]), policy.b3, bs, NEURAL_ACTIONS]
    return [q, [x, z1, a1, z2, a2]]

# ============================================================
# Backpropagation — compute gradients and update weights
# ============================================================

define train_step(online, target, buf, hp) as:
    if buf.size < hp.batch_size:
        return [-1.0, 0.0]

    sample is buffer_sample of [buf, hp.batch_size]
    obs is sample[0]
    actions is sample[1]
    rewards is sample[2]
    next_obs is sample[3]
    dones is sample[4]

    # Forward on online network
    result is forward_cached of [online, obs]
    q_all is result[0]
    cache is result[1]

    # Double-DQN: select the next action with the ONLINE net, evaluate it with
    # the TARGET net. Vanilla DQN uses target's own max, which compounds
    # positive function-approx error through the bootstrap and drove Q far
    # above realisable returns (~96 vs ~7), collapsing the greedy policy to a
    # single action. Decoupling selection from evaluation removes that bias.
    t_result is forward_cached of [target, next_obs]
    q_next_target is t_result[0]
    o_next is forward_cached of [online, next_obs]
    q_next_online is o_next[0]

    # Compute TD targets and error gradient
    bs is hp.batch_size
    dq is buffer of [bs, NEURAL_ACTIONS]
    loss is 0.0
    total_max_q is 0.0

    for i in range of bs:
        ib is i * NEURAL_ACTIONS
        # Double-DQN value of next state: argmax over the ONLINE net, value
        # read from the TARGET net at that action.
        a_star is 0
        for a in range of NEURAL_ACTIONS:
            if q_next_online[ib + a] > q_next_online[ib + a_star]:
                a_star is a
        next_q is q_next_target[ib + a_star]
        total_max_q is total_max_q + next_q

        # TD target
        td_target is rewards[i] + hp.gamma * next_q * (1.0 - dones[i])

        # TD error for taken action
        a_taken is actions[i]
        td_err is q_all[ib + a_taken] - td_target

        # Huber loss (delta = 1): quadratic for |err| <= 1, linear beyond, so
        # large TD errors can't dominate the gradient. The gradient is the TD
        # error clamped to [-1, 1] — capping at the loss level rather than
        # relying solely on the cruder per-weight clip applied after backprop.
        abs_err is td_err
        if abs_err < 0.0:
            abs_err is 0.0 - abs_err
        if abs_err <= 1.0:
            loss is loss + 0.5 * td_err * td_err
            dq[ib + a_taken] is (2.0 / bs) * td_err
        else:
            loss is loss + (abs_err - 0.5)
            grad is 1.0
            if td_err < 0.0:
                grad is -1.0
            dq[ib + a_taken] is (2.0 / bs) * grad

    loss is loss / bs

    # Backprop through layers
    x is cache[0]
    z1 is cache[1]
    a1 is cache[2]
    z2 is cache[3]
    a2 is cache[4]

    # Pre-compute transposed weights (avoids recomputing in hot loop)
    w3t is transpose of online.w3
    w2t is transpose of online.w2

    # Layer 3: a2 -> q
    a2t is transpose of a2
    dw3 is matmul of [a2t, dq]
    db3 is []
    for c in range of NEURAL_ACTIONS:
        s is 0.0
        for r in range of bs:
            s is s + dq[r * NEURAL_ACTIONS + c]
        append of [db3, s]
    da2 is matmul of [dq, w3t]

    # ReLU backward for layer 2: pass da2 through where z2 > 0, else 0.
    dz2 is buffer of [bs, NEURAL_HIDDEN2]
    for i in range of bs:
        ib is i * NEURAL_HIDDEN2
        for j in range of NEURAL_HIDDEN2:
            if z2[ib + j] > 0:
                dz2[ib + j] is da2[ib + j]

    # Layer 2: a1 -> z2
    a1t is transpose of a1
    dw2 is matmul of [a1t, dz2]
    db2 is []
    for c in range of NEURAL_HIDDEN2:
        s is 0.0
        for r in range of bs:
            s is s + dz2[r * NEURAL_HIDDEN2 + c]
        append of [db2, s]
    da1 is matmul of [dz2, w2t]

    # ReLU backward for layer 1
    for i in range of bs:
        ib is i * NEURAL_HIDDEN1
        for j in range of NEURAL_HIDDEN1:
            if z1[ib + j] <= 0:
                da1[ib + j] is 0.0

    # Layer 1: x -> z1
    xt is transpose of x
    dw1 is matmul of [xt, da1]
    db1 is []
    for c in range of NEURAL_HIDDEN1:
        s is 0.0
        for r in range of bs:
            s is s + da1[r * NEURAL_HIDDEN1 + c]
        append of [db1, s]

    # SGD update with gradient clipping
    lr is hp.lr

    # Update w1 — iterate full NEURAL_INPUT_SIZE rows (w1 has stacked-frame + aux rows,
    # not just one obs-frame's worth)
    for r in range of NEURAL_INPUT_SIZE:
        rb is r * NEURAL_HIDDEN1
        for c in range of NEURAL_HIDDEN1:
            g is dw1[rb + c]
            if g > 1.0:
                g is 1.0
            elif g < -1.0:
                g is -1.0
            online.w1[rb + c] is online.w1[rb + c] - lr * g
    # Update b1
    for i in range of NEURAL_HIDDEN1:
        g is db1[i]
        if g > 1.0:
            g is 1.0
        elif g < -1.0:
            g is -1.0
        online.b1[i] is online.b1[i] - lr * g

    # Update w2
    for r in range of NEURAL_HIDDEN1:
        rb is r * NEURAL_HIDDEN2
        for c in range of NEURAL_HIDDEN2:
            g is dw2[rb + c]
            if g > 1.0:
                g is 1.0
            elif g < -1.0:
                g is -1.0
            online.w2[rb + c] is online.w2[rb + c] - lr * g
    # Update b2
    for i in range of NEURAL_HIDDEN2:
        g is db2[i]
        if g > 1.0:
            g is 1.0
        elif g < -1.0:
            g is -1.0
        online.b2[i] is online.b2[i] - lr * g

    # Update w3
    for r in range of NEURAL_HIDDEN2:
        rb is r * NEURAL_ACTIONS
        for c in range of NEURAL_ACTIONS:
            g is dw3[rb + c]
            if g > 1.0:
                g is 1.0
            elif g < -1.0:
                g is -1.0
            online.w3[rb + c] is online.w3[rb + c] - lr * g
    # Update b3
    for i in range of NEURAL_ACTIONS:
        g is db3[i]
        if g > 1.0:
            g is 1.0
        elif g < -1.0:
            g is -1.0
        online.b3[i] is online.b3[i] - lr * g

    return [loss, total_max_q / bs]

# ============================================================
# Copy weights from online to target network
# ============================================================

define copy_weights(src, dst) as:
    for i in range of (len of src.w1):
        dst.w1[i] is src.w1[i]
    for i in range of (len of src.b1):
        dst.b1[i] is src.b1[i]
    for i in range of (len of src.w2):
        dst.w2[i] is src.w2[i]
    for i in range of (len of src.b2):
        dst.b2[i] is src.b2[i]
    for i in range of (len of src.w3):
        dst.w3[i] is src.w3[i]
    for i in range of (len of src.b3):
        dst.b3[i] is src.b3[i]

# ============================================================
# Reward function
# ============================================================

# Distance to the nearest active food (torus metric). Used for dense
# reward shaping so the agent gets a gradient every tick rather than only
# on the rare food-eaten event.
define nearest_food_dist(game) as:
    best is 9999.0
    for i in range of (len of game.food):
        if game.food[i].active == 1:
            d is torus_dist of [game.px, game.py, game.food[i].px, game.food[i].py, game.world_w, game.world_h]
            if d < best:
                best is d
    return best

define compute_reward(game, prev_score, prev_energy, prev_food_dist, cur_food_dist, prev_tier) as:
    r is 0.0
    # Food eaten since last tick (sparse, high-value)
    if game.score > prev_score:
        r is r + 10.0
    # Evolve reward: advancing a tier is real progress. The death penalty for
    # the harsher world a new tier summons supplies the counter-pressure, so
    # the policy learns *when* to evolve rather than spamming it the instant
    # it becomes eligible.
    if game.scale_tier > prev_tier:
        r is r + 5.0
    # Energy change (small penalty for losing energy)
    if game.energy < prev_energy:
        r is r - 0.1
    # Death penalty
    if game.game_over == 1:
        r is r - 20.0
    # Small survival bonus
    r is r + 0.01
    # Dense shaping: reward closing distance to the nearest food. Clamped so
    # torus wrap-around jumps (which flip sign of the delta) can't be farmed.
    delta is prev_food_dist - cur_food_dist
    if delta > 0.5:
        delta is 0.5
    elif delta < -0.5:
        delta is -0.5
    r is r + 0.5 * delta
    return r

# ============================================================
# Training loop
# ============================================================

print of f"=== Tidepool DQN Training ==="
print of f"Episodes: {hp.episodes}, LR: {hp.lr}, Batch: {hp.batch_size}"
print of f"Buffer: {hp.buffer_size}, Target update: {hp.target_update}"
print of "---"

online is new_policy of null
if hp.resume == 1:
    loaded is load_policy of null
    if loaded != null:
        online is loaded
        print of f"Resumed from {POLICY_PATH} (eps_start {hp.epsilon_start})"
    else:
        print of "No usable checkpoint found — starting fresh"
target_net is new_policy of null
copy_weights of [online, target_net]
buf is new_buffer of hp.buffer_size

epsilon is hp.epsilon_start
step_count is 0
best_avg_score is -9999.0
ep_offset is 0
recent_scores is []
recent_lengths is []
recent_tiers is []

# Per-block telemetry: mean loss and mean target-Q over each 50-ep window.
# Both are reset after each block so the CSV row reflects only that window.
loss_sum is 0.0
q_sum is 0.0
train_step_count is 0

LOG_PATH is "models/train_log.csv"
STATE_PATH is "models/train_state.txt"
mkdir of "models"
# Resume-aware logging: on --resume, continue the prior run's episode count
# and best-score bar and APPEND to the learning curve instead of clobbering it
# (so a chained multi-run effort reads as one continuous curve). On a fresh
# run, start the curve with a header.
log_buf is "ep,avg_score,avg_len,mean_tier,loss,mean_q,epsilon\n"
if hp.resume == 1 and (file_exists of STATE_PATH) == 1:
    st is split of [read_text of STATE_PATH, "\n"]
    ep_offset is floor of (num of st[0])
    best_avg_score is num of st[1]
    if (file_exists of LOG_PATH) == 1:
        log_buf is read_text of LOG_PATH
    print of f"Resumed training state: ep_offset={ep_offset}, best_avg_score={best_avg_score}"
else:
    write_text of [LOG_PATH, log_buf]

for ep in range of hp.episodes:
    game is new_game of [40.0, 20.0, random_int of [1, 99999]]
    obs_stack is new_observation_stack of null
    raw_obs is build_observation of game
    push_observation of [obs_stack, raw_obs]
    obs is build_stacked_observation of [obs_stack, game]
    ep_return is 0.0
    ep_length is 0
    prev_score is 0
    prev_energy is game.energy
    prev_food_dist is nearest_food_dist of game
    prev_tier is game.scale_tier

    for tick in range of hp.tick_limit:
        # Epsilon-greedy action selection
        if (random of null) < epsilon:
            action is random_int of [0, NEURAL_ACTIONS - 1]
        else:
            q is policy_forward of [online, obs]
            action is argmax of q

        # Apply action to game
        game.thrusting is 0
        game.braking is 0
        game.turning is 0
        if action == 1:
            game.thrusting is 1
        elif action == 2:
            game.turning is -1
            game.thrusting is 1
        elif action == 3:
            game.turning is 1
            game.thrusting is 1
        elif action == 4:
            game.braking is 1
        elif action == 5:
            # Deliberate evolve (no-op unless game.evolve_ready)
            game_action of [game, ACTION_EVOLVE]

        # Also buy mutations (still auto-piloted, not learned)
        buy is autopilot_buy_mutation of game
        if buy > 0:
            game_action of [game, buy]

        game_tick of game

        # Build next observation and reward
        next_raw_obs is build_observation of game
        push_observation of [obs_stack, next_raw_obs]
        next_obs is build_stacked_observation of [obs_stack, game]
        cur_food_dist is nearest_food_dist of game
        reward is compute_reward of [game, prev_score, prev_energy, prev_food_dist, cur_food_dist, prev_tier]
        done is game.game_over
        prev_score is game.score
        prev_energy is game.energy
        prev_food_dist is cur_food_dist
        prev_tier is game.scale_tier

        # Store transition
        buffer_add of [buf, obs, action, reward, next_obs, done]
        obs is next_obs
        ep_return is ep_return + reward
        ep_length is ep_length + 1
        step_count is step_count + 1

        # Train every step. The earlier every-4th-step throttle (a perf hedge
        # for interpreted EigenScript) starved the network of updates and is a
        # prime suspect for the flat learning curve; a denser update schedule
        # plus the larger batch (32) gives a far stronger, less noisy gradient.
        # Trade-off: wall-clock per episode rises substantially (4x more
        # train_step calls, each over a 4x-larger batch) — lower --batch or run
        # fewer episodes if throughput matters on slow hardware.
        if buf.size >= hp.batch_size:
            step_out is train_step of [online, target_net, buf, hp]
            if step_out[0] >= 0.0:
                loss_sum is loss_sum + step_out[0]
                q_sum is q_sum + step_out[1]
                train_step_count is train_step_count + 1

        # Update target network periodically
        if step_count % hp.target_update == 0:
            copy_weights of [online, target_net]

        if done == 1:
            break

    # Decay epsilon
    epsilon is epsilon * hp.epsilon_decay
    if epsilon < hp.epsilon_end:
        epsilon is hp.epsilon_end

    # Track stats. game.scale_tier at episode end == number of evolves this
    # episode (tier only rises, one per evolve), so mean tier is the headline
    # signal for whether the policy is learning to use the evolve action.
    append of [recent_scores, game.score]
    append of [recent_lengths, ep_length]
    append of [recent_tiers, game.scale_tier]

    # Print every 50 episodes
    if (ep + 1) % 50 == 0:
        avg_score is 0.0
        avg_len is 0.0
        avg_tier is 0.0
        for i in range of (len of recent_scores):
            avg_score is avg_score + recent_scores[i]
            avg_len is avg_len + recent_lengths[i]
            avg_tier is avg_tier + recent_tiers[i]
        n is len of recent_scores
        if n > 0:
            avg_score is avg_score / n
            avg_len is avg_len / n
            avg_tier is avg_tier / n

        mean_loss is 0.0
        mean_q is 0.0
        if train_step_count > 0:
            mean_loss is loss_sum / train_step_count
            mean_q is q_sum / train_step_count
        loss_sum is 0.0
        q_sum is 0.0
        train_step_count is 0

        gep is ep_offset + ep + 1
        print of f"Ep {gep} | score {avg_score} | len {avg_len} | tier {avg_tier} | loss {mean_loss} | Q {mean_q} | eps {epsilon} | buf {buf.size}"

        log_buf is f"{log_buf}{gep},{avg_score},{avg_len},{avg_tier},{mean_loss},{mean_q},{epsilon}\n"
        write_text of [LOG_PATH, log_buf]

        # Save best
        if avg_score > best_avg_score:
            best_avg_score is avg_score
            online.loaded is 1
            save_policy of online
            print of f"  -> new best avg score {best_avg_score}, saved"

        # Persist resumable training state (global episode + best bar),
        # crash-safe via tmp+rename, so --resume continues correctly.
        stxt is f"{gep}\n{best_avg_score}\n"
        write_text of [f"{STATE_PATH}.tmp", stxt]
        rename of [f"{STATE_PATH}.tmp", STATE_PATH]

        # Reset the block accumulators now that this 50-episode window is
        # logged, so the next row averages exactly the next 50 episodes.
        # (Resetting on a len>50 guard instead used to silently drop the
        # episode that tripped it — every 50th episode — from the curve.)
        recent_scores is []
        recent_lengths is []
        recent_tiers is []

# Keep the BEST checkpoint as the saved policy. The previous unconditional
# final save overwrote it with the last-episode policy, which DQN often
# degrades late in training (catastrophic forgetting) — so the saved model
# could be far worse than the best one the run actually found. Only fall back
# to saving the final policy if no checkpoint was ever saved (very short runs
# that never hit a 50-episode print).
if best_avg_score <= -9999.0:
    online.loaded is 1
    save_policy of online
    print of "(no checkpoint beat the initial bar; saved final policy)"
print of "---"
print of f"Training complete. Best avg score: {best_avg_score}"
print of f"Best policy saved to {POLICY_PATH}"
