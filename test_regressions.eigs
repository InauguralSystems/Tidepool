# Regression tests — assertions for bugs caught in code review.
# Uses the `assert` builtin directly so it works without lib/test.eigs
# being on the load path.

load_file of "src/game.eigs"
load_file of "src/editor.eigs"

print of "=== Tidepool regressions ==="

# ------------------------------------------------------------
# Tier progression — eating enough food UNLOCKS evolve (game.evolve_ready);
# the tier only advances on a deliberate ACTION_EVOLVE. Food no longer
# auto-advances the tier (that path was removed — it short-circuited the
# rich evolve and made the AI and human play different games).
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]

# Quiet the world so nothing mutates food_eaten during the test.
for i in range of (len of game.food):
    game.food[i].active is 0
for i in range of (len of game.predators):
    game.predators[i].active is 0

game.food_eaten is 10
assert of [game.scale_tier == 0, "tier starts at 0"]
assert of [game.evolve_ready == 0, "not eligible before a tick recomputes it"]

# Eating to the threshold makes evolve available but does NOT advance the tier.
game_tick of game
assert of [game.evolve_ready == 1, "evolve unlocked at food_eaten=10"]
assert of [game.scale_tier == 0, "tier does NOT auto-advance from food alone"]

for i in range of 10:
    game_tick of game
assert of [game.scale_tier == 0, "tier stays at 0 without an evolve action"]
assert of [game.evolve_ready == 1, "stays eligible while not yet evolved"]

# The deliberate evolve action consumes eligibility and advances one tier.
game_action of [game, ACTION_EVOLVE]
assert of [game.scale_tier == 1, "ACTION_EVOLVE advances to tier 1"]
assert of [game.evolve_ready == 0, "eligibility consumed by evolving"]

# Re-eligible only after crossing the next threshold (20), and one evolve
# advances exactly one tier (no rocketing).
game.food_eaten is 20
game_tick of game
assert of [game.evolve_ready == 1, "evolve unlocked again at food_eaten=20"]
game_action of [game, ACTION_EVOLVE]
assert of [game.scale_tier == 2, "second evolve advances to tier 2"]

# Evolving when not eligible is a no-op.
game_action of [game, ACTION_EVOLVE]
assert of [game.scale_tier == 2, "evolve with no eligibility does nothing"]

print of "  tier progression: ok"

# ------------------------------------------------------------
# Toroidal world wrap — player walking off the east edge reappears
# on the west edge.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
for i in range of (len of game.predators):
    game.predators[i].active is 0

game.px is 59.95
game.py is 10.0
game.vx is 10.0
game.vy is 0.0
game.angle is 0.0
game.thrusting is 0
game.braking is 0

game_tick of game
assert of [game.px < 5.0, "player px wraps past world_w"]
assert of [game.px >= 0.0, "player px stays non-negative after wrap"]

print of "  torus wrap: ok"

# ------------------------------------------------------------
# Food collision — food at player position is consumed on the next tick.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
for i in range of (len of game.predators):
    game.predators[i].active is 0
# Deactivate all food, then place exactly one at player position
for i in range of (len of game.food):
    game.food[i].active is 0
game.food[0].px is game.px
game.food[0].py is game.py
game.food[0].active is 1
before_count is game.food_eaten
before_energy is game.energy

game_tick of game
assert of [game.food_eaten == before_count + 1, "food at player position is eaten"]
assert of [game.energy > before_energy, "eating food increases energy"]

print of "  food collision: ok"

# ------------------------------------------------------------
# Growth — eating increases mass, which feeds creature_radius (size) and
# creature_collision_power (combat strength). Mass was previously frozen
# at 1, leaving the whole grow-bigger arc inert.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
for i in range of (len of game.predators):
    game.predators[i].active is 0
for i in range of (len of game.food):
    game.food[i].active is 0
game.food[0].px is game.px
game.food[0].py is game.py
game.food[0].active is 1
mass_before is game.mass
power_before is creature_collision_power of [game.creature, game.spikes_level, game.mass]
game_tick of game
assert of [game.mass > mass_before, "eating food increases mass"]
power_after is creature_collision_power of [game.creature, game.spikes_level, game.mass]
assert of [power_after > power_before, "growing mass increases collision power"]

print of "  growth (mass on eat): ok"

# ------------------------------------------------------------
# Meat pool — killing predators does not grow the meat list.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
meat_len_before is len of game.meat

# Pre-allocation should already fill the pool to MAX_MEAT.
assert of [meat_len_before == MAX_MEAT, "meat pool pre-allocated to MAX_MEAT"]

# All slots start inactive.
inactive is 0
for i in range of (len of game.meat):
    if game.meat[i].active == 0:
        inactive is inactive + 1
assert of [inactive == MAX_MEAT, "all meat slots start inactive"]

# Spawn some meat — list length must not change.
result is spawn_meat of [game.meat, 1.0, 1.0, 300]
assert of [result == 1, "spawn_meat returns 1 when pool has a free slot"]
assert of [(len of game.meat) == meat_len_before, "spawn_meat does not grow the list"]

print of "  meat pool: ok"

# ------------------------------------------------------------
# Combat — a losing collision is no longer a one-hit kill.
# Old behavior: any predator that out-powered the engaged zone
# killed the player instantly. Now the player takes an energy bite
# plus knockback and brief invulnerability, and only dies when
# energy is exhausted.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
# Silence food so energy only changes through combat.
for i in range of (len of game.food):
    game.food[i].active is 0
# Park a single strong predator on the player; disable the rest.
for i in range of (len of game.predators):
    game.predators[i].active is 0
boss is game.predators[0]
boss.active is 1
boss.size is 5
boss.radius is 1.5
boss.stunned_timer is 0
boss.px is game.px
boss.py is game.py
game.energy is 100
game.invuln_timer is 0

game_tick of game
assert of [game.game_over == 0, "strong predator does not one-hit-kill from full energy"]
assert of [game.energy < 100, "a losing collision costs energy"]
assert of [game.energy > 0, "a single bite does not drain all energy"]
assert of [game.invuln_timer > 0, "i-frames engage after taking a bite"]

# A second adjacent hit while invulnerable deals no further damage.
energy_after_bite is game.energy
boss.px is game.px
boss.py is game.py
game_tick of game
assert of [game.energy == energy_after_bite, "no further damage while invulnerable"]

print of "  combat (no one-hit kill): ok"

# ------------------------------------------------------------
# Part-drop -> unlock -> editor-equip loop. A gated weapon (poison)
# must be undiscoverable in the editor until its part drop is collected,
# then equippable. Guards the full progression chain.
# ------------------------------------------------------------
eg is new_game of [40.0, 20.0, 42]
for i in range of CREATURE_MAX_SOCKETS:
    eg.creature.appendages[i] is APPENDAGE_NONE

# Locked: clicking poison (part_index 5, app_type 4) equips nothing.
assert of [(part_unlocked of [eg, PART_TYPE_APPENDAGE, 4]) == 0, "poison starts locked"]
editor_handle_part_click of [5, eg.creature, eg]
poison_while_locked is 0
for i in range of CREATURE_MAX_SOCKETS:
    if eg.creature.appendages[i] == APPENDAGE_POISON:
        poison_while_locked is 1
assert of [poison_while_locked == 0, "locked weapon cannot be equipped"]

# Collect a poison part drop at the player: +5 DNA and unlock.
eg.px is 5.0
eg.py is 5.0
dna_before is eg.dna
append of [eg.part_drops, new_part_drop of [5.0, 5.0, PART_TYPE_APPENDAGE, 4]]
update_part_drops of eg
assert of [eg.dna == dna_before + 5, "collecting a part grants +5 DNA"]
assert of [(part_unlocked of [eg, PART_TYPE_APPENDAGE, 4]) != 0, "collected part is unlocked"]

# Now the editor equips it.
editor_handle_part_click of [5, eg.creature, eg]
poison_equipped is 0
for i in range of CREATURE_MAX_SOCKETS:
    if eg.creature.appendages[i] == APPENDAGE_POISON:
        poison_equipped is 1
assert of [poison_equipped == 1, "unlocked weapon equips via editor"]

print of "  part-drop -> unlock -> editor equip: ok"

print of ""
print of "=== All regressions passed ==="
