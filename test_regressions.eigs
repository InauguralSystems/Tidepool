# Regression tests — assertions for bugs caught in code review.
# Uses the `assert` builtin directly so it works without lib/test.eigs
# being on the load path.

load_file of "src/game.eigs"
load_file of "src/editor.eigs"
load_file of "src/renderer.eigs"
load_file of "src/audio.eigs"
import ui

print of "=== Tidepool regressions ==="

# ------------------------------------------------------------
# Tier progression — eating enough food UNLOCKS evolve (game.evolve_ready);
# the tier only advances on a deliberate ACTION_EVOLVE. Food no longer
# auto-advances the tier (that path was removed — it short-circuited the
# rich evolve and made the AI and human play different games).
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]

# Quiet the world so nothing mutates food_eaten during the test.
for i in range of (len of game.food):
    game.food[i].active is 0
for i in range of (len of game.predators):
    game.predators[i].active is 0

game.food_eaten is 10
assert of [game.scale_tier == 0, "tier starts at 0"]
assert of [game.evolve_ready == 0, "not eligible before a tick recomputes it"]

# Eating to the threshold makes evolve available but does NOT advance the tier.
game_tick of game
assert of [game.evolve_ready == 1, "evolve unlocked at food_eaten=10"]
assert of [game.scale_tier == 0, "tier does NOT auto-advance from food alone"]

for i in range of 10:
    game_tick of game
assert of [game.scale_tier == 0, "tier stays at 0 without an evolve action"]
assert of [game.evolve_ready == 1, "stays eligible while not yet evolved"]

# The deliberate evolve action consumes eligibility and advances one tier.
game_action of [game, ACTION_EVOLVE]
assert of [game.scale_tier == 1, "ACTION_EVOLVE advances to tier 1"]
assert of [game.evolve_ready == 0, "eligibility consumed by evolving"]

# Re-eligible only after crossing the next threshold (20), and one evolve
# advances exactly one tier (no rocketing).
game.food_eaten is 20
game_tick of game
assert of [game.evolve_ready == 1, "evolve unlocked again at food_eaten=20"]
game_action of [game, ACTION_EVOLVE]
assert of [game.scale_tier == 2, "second evolve advances to tier 2"]

# Evolving when not eligible is a no-op.
game_action of [game, ACTION_EVOLVE]
assert of [game.scale_tier == 2, "evolve with no eligibility does nothing"]

print of "  tier progression: ok"

# ------------------------------------------------------------
# Toroidal world wrap — player walking off the east edge reappears
# on the west edge.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
for i in range of (len of game.predators):
    game.predators[i].active is 0

game.px is 59.95
game.py is 10.0
game.vx is 10.0
game.vy is 0.0
game.angle is 0.0
game.thrusting is 0
game.braking is 0

game_tick of game
assert of [game.px < 5.0, "player px wraps past world_w"]
assert of [game.px >= 0.0, "player px stays non-negative after wrap"]

print of "  torus wrap: ok"

# ------------------------------------------------------------
# Food collision — food at player position is consumed on the next tick.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
for i in range of (len of game.predators):
    game.predators[i].active is 0
# Deactivate all food, then place exactly one at player position
for i in range of (len of game.food):
    game.food[i].active is 0
game.food[0].px is game.px
game.food[0].py is game.py
game.food[0].active is 1
before_count is game.food_eaten
before_energy is game.energy

game_tick of game
assert of [game.food_eaten == before_count + 1, "food at player position is eaten"]
assert of [game.energy > before_energy, "eating food increases energy"]

print of "  food collision: ok"

# ------------------------------------------------------------
# Growth — eating increases mass, which feeds creature_radius (size) and
# creature_collision_power (combat strength). Mass was previously frozen
# at 1, leaving the whole grow-bigger arc inert.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
for i in range of (len of game.predators):
    game.predators[i].active is 0
for i in range of (len of game.food):
    game.food[i].active is 0
game.food[0].px is game.px
game.food[0].py is game.py
game.food[0].active is 1
mass_before is game.mass
power_before is creature_collision_power of [game.creature, game.spikes_level, game.mass]
game_tick of game
assert of [game.mass > mass_before, "eating food increases mass"]
power_after is creature_collision_power of [game.creature, game.spikes_level, game.mass]
assert of [power_after > power_before, "growing mass increases collision power"]

print of "  growth (mass on eat): ok"

# ------------------------------------------------------------
# Meat pool — killing predators does not grow the meat list.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
meat_len_before is len of game.meat

# Pre-allocation should already fill the pool to MAX_MEAT.
assert of [meat_len_before == MAX_MEAT, "meat pool pre-allocated to MAX_MEAT"]

# All slots start inactive.
inactive is 0
for i in range of (len of game.meat):
    if game.meat[i].active == 0:
        inactive is inactive + 1
assert of [inactive == MAX_MEAT, "all meat slots start inactive"]

# Spawn some meat — list length must not change.
result is spawn_meat of [game.meat, 1.0, 1.0, 300]
assert of [result == 1, "spawn_meat returns 1 when pool has a free slot"]
assert of [(len of game.meat) == meat_len_before, "spawn_meat does not grow the list"]

# Full pool: spawn_meat recycles the slot closest to expiring instead of
# silently dropping the meat. Fill every slot, give one a tiny lifetime, then
# spawn again — it must still succeed without growing the list, and the
# short-lived slot must now carry the new chunk.
for i in range of (len of game.meat):
    game.meat[i].active is 1
    game.meat[i].lifetime is 200
game.meat[7].lifetime is 1
r2 is spawn_meat of [game.meat, 42.0, 42.0, 300]
assert of [r2 == 1, "spawn_meat still succeeds when the pool is full"]
assert of [(len of game.meat) == meat_len_before, "full-pool spawn_meat does not grow the list"]
assert of [game.meat[7].px == 42.0 and game.meat[7].lifetime == 300, "full pool recycles the soonest-to-expire slot"]

print of "  meat pool: ok"

# ------------------------------------------------------------
# Combat — a losing collision is no longer a one-hit kill.
# Old behavior: any predator that out-powered the engaged zone
# killed the player instantly. Now the player takes an energy bite
# plus knockback and brief invulnerability, and only dies when
# energy is exhausted.
# ------------------------------------------------------------
game is new_game of [60.0, 20.0, 42]
# Silence food so energy only changes through combat.
for i in range of (len of game.food):
    game.food[i].active is 0
# Park a single strong predator on the player; disable the rest.
for i in range of (len of game.predators):
    game.predators[i].active is 0
boss is game.predators[0]
boss.active is 1
boss.size is 5
boss.radius is 1.5
boss.stunned_timer is 0
boss.px is game.px
boss.py is game.py
game.energy is 100
game.invuln_timer is 0

game_tick of game
assert of [game.game_over == 0, "strong predator does not one-hit-kill from full energy"]
assert of [game.energy < 100, "a losing collision costs energy"]
assert of [game.energy > 0, "a single bite does not drain all energy"]
assert of [game.invuln_timer > 0, "i-frames engage after taking a bite"]

# A second adjacent hit while invulnerable deals no further damage.
energy_after_bite is game.energy
boss.px is game.px
boss.py is game.py
game_tick of game
assert of [game.energy == energy_after_bite, "no further damage while invulnerable"]

print of "  combat (no one-hit kill): ok"

# ------------------------------------------------------------
# Part-drop -> unlock -> editor-equip loop. A gated weapon (poison)
# must be undiscoverable in the editor until its part drop is collected,
# then equippable. Guards the full progression chain.
# ------------------------------------------------------------
eg is new_game of [40.0, 20.0, 42]
for i in range of CREATURE_MAX_SOCKETS:
    eg.creature.appendages[i] is APPENDAGE_NONE

# Locked: clicking poison (part_index 5, app_type 4) equips nothing.
assert of [(part_unlocked of [eg, PART_TYPE_APPENDAGE, 4]) == 0, "poison starts locked"]
editor_handle_part_click of [5, eg.creature, eg]
poison_while_locked is 0
for i in range of CREATURE_MAX_SOCKETS:
    if eg.creature.appendages[i] == APPENDAGE_POISON:
        poison_while_locked is 1
assert of [poison_while_locked == 0, "locked weapon cannot be equipped"]

# Collect a poison part drop at the player: +5 DNA and unlock.
eg.px is 5.0
eg.py is 5.0
dna_before is eg.dna
append of [eg.part_drops, new_part_drop of [5.0, 5.0, PART_TYPE_APPENDAGE, 4]]
update_part_drops of eg
assert of [eg.dna == dna_before + 5, "collecting a part grants +5 DNA"]
assert of [(part_unlocked of [eg, PART_TYPE_APPENDAGE, 4]) != 0, "collected part is unlocked"]

# Now the editor equips it.
editor_handle_part_click of [5, eg.creature, eg]
poison_equipped is 0
for i in range of CREATURE_MAX_SOCKETS:
    if eg.creature.appendages[i] == APPENDAGE_POISON:
        poison_equipped is 1
assert of [poison_equipped == 1, "unlocked weapon equips via editor"]

print of "  part-drop -> unlock -> editor equip: ok"

# ------------------------------------------------------------
# Headless rendering — the draw-list layer (src/draw.eigs) lets a frame be
# built and inspected with NO window (the way DMG's --render-probe inspects
# its framebuffer). Guards that the renderer runs headless and emits a
# plausible frame.
# ------------------------------------------------------------
rg is new_game of [40.0, 20.0, 99]
for i in range of 60:
    autopilot_decide of rg
    game_tick of rg
draw_record_begin of null
render_world_only of [rg, 800, 600]
n_ops is draw_op_count of null
n_clear is draw_count_of of "clear"
n_circle is draw_count_of of "circle"
draw_record_end of null
assert of [n_ops > 50, "a rendered world frame emits many draw ops"]
assert of [n_clear >= 1, "frame clears the background"]
assert of [n_circle >= 1, "frame draws creatures (circles)"]
# Recording must not leak into the next capture.
draw_record_begin of null
draw_record_end of null
assert of [(draw_op_count of null) == 0, "record_begin starts a fresh draw-list"]

print of "  headless render (draw-list): ok"

# ------------------------------------------------------------
# Stunned combat — a predator that is stunned (e.g. hit by the electric part)
# must NOT bite the player, even sitting on top of it. The bite branch was
# gated only on invuln; now it also checks pred.stunned_timer.
# ------------------------------------------------------------
define stun_bite_loss(stun) as:
    sg is new_game of [60.0, 20.0, 42]
    for i in range of (len of sg.food):
        sg.food[i].active is 0
    for i in range of (len of sg.predators):
        sg.predators[i].active is 0
    # One big predator right on the player -> player is out-powered (bite path).
    sp is sg.predators[0]
    sp.active is 1
    sp.size is 5
    sp.hp is sp.size + 1
    sp.radius is 0.5 + sp.size * 0.3
    sp.px is sg.px
    sp.py is sg.py
    sp.stunned_timer is stun
    sg.invuln_timer is 0
    e0 is sg.energy
    game_tick of sg
    return e0 - sg.energy

assert of [(stun_bite_loss of 0) > 0, "an un-stunned predator on the player bites"]
assert of [(stun_bite_loss of 90) == 0, "a stunned predator does NOT bite the player"]
print of "  stunned predator does not bite: ok"

# ------------------------------------------------------------
# Particle re-fire on frozen frames (#21) — process_game_events consumes
# the event flags and fires the wake once per tick, so overlay frames
# (pause / game-over render without game_tick re-arming the flags) cannot
# re-spawn bursts every frame. Existing particles still decay normally.
# ------------------------------------------------------------
pg is new_game of [40.0, 20.0, 7]
# Drain particles left by earlier sections so the 100-cap can't mask spawns.
for i in range of 300:
    update_particles of null
assert of [(particle_count of null) == 0, "particle drain leaves none alive"]

# A kill event fires its burst exactly once, not once per rendered frame.
pg.vx is 0.0
pg.vy is 0.0
pg.event_kill_x is 5.0
pg.event_kill_y is 5.0
pg.event_kill_palette is 0
process_game_events of pg
burst is particle_count of null
assert of [burst > 0, "kill event spawns a death burst"]
process_game_events of pg
assert of [(particle_count of null) == burst, "frozen frame does not re-fire the burst"]

# A fresh event (as the next game_tick would set) still fires in play.
pg.event_kill_x is 6.0
pg.event_kill_y is 6.0
process_game_events of pg
assert of [(particle_count of null) > burst, "a fresh event still spawns a burst"]

# Wake trail: at most one per (third) tick, never once per rendered frame.
pg.vx is 2.0
pg.tick is 3
w0 is particle_count of null
process_game_events of pg
w1 is particle_count of null
assert of [w1 == w0 + 1, "wake fires on a wake tick"]
process_game_events of pg
assert of [(particle_count of null) == w1, "frozen frame does not re-fire the wake"]
pg.tick is 6
process_game_events of pg
assert of [(particle_count of null) == w1 + 1, "wake fires again once the tick advances"]

print of "  no particle re-fire on frozen frames: ok"

# ------------------------------------------------------------
# APPENDAGE_JET renderer case (#22) — a jet appendage must draw a distinct
# cap (nozzle + thrust lines), not just the bare stalk an unhandled type
# falls through to.
# ------------------------------------------------------------
jg is new_game of [40.0, 20.0, 5]
jspec is jg.creature
for i in range of CREATURE_MAX_SOCKETS:
    jspec.appendages[i] is APPENDAGE_NONE
draw_record_begin of null
draw_creature_body of [jspec, 200, 200, 0.0, 16, 0, 0]
lines_bare is draw_count_of of "line"
jspec.appendages[0] is APPENDAGE_JET
draw_record_begin of null
draw_creature_body of [jspec, 200, 200, 0.0, 16, 0, 0]
lines_jet is draw_count_of of "line"
draw_record_end of null
assert of [lines_jet - lines_bare >= 3, "jet appendage draws a distinct cap beyond the bare stalk"]

print of "  jet appendage renders: ok"

# ------------------------------------------------------------
# Editor palette unlock gating (#20) — the palette dropdown must respect
# unlocked_palettes exactly like the part buttons: a locked selection is
# ignored on Apply, an unlocked one applies.
# ------------------------------------------------------------
ug is new_game of [40.0, 20.0, 42]
ug.creature.palette is 0
assert of [(part_unlocked of [ug, PART_TYPE_PALETTE, 1]) == 0, "palette 1 starts locked"]
editor_open of [ug.creature, 800, 600]
pal_w is ui.find_by_id of [_editor_root, "ed_palette"]
assert of [pal_w != null, "editor palette dropdown exists"]
pal_w.selected is 1
editor_apply_to_spec of [ug.creature, ug]
assert of [ug.creature.palette == 0, "locked palette selection is not applied"]
ug.unlocked_palettes is bit_or of [ug.unlocked_palettes, bit_shl of [1, 1]]
editor_apply_to_spec of [ug.creature, ug]
assert of [ug.creature.palette == 1, "unlocked palette selection applies"]
editor_close of null

print of "  editor palette unlock gating: ok"

# ------------------------------------------------------------
# Audio init hardening (#23) — on a runtime without the audio builtins
# (this headless build is exactly that), audio_game_init must degrade to
# silence instead of throwing undefined_name and taking down startup.
# ------------------------------------------------------------
audio_game_init of null
assert of [_audio_ready == 0, "audio stays un-ready without audio builtins"]
audio_play_sound of "eat_plant"
assert of [(audio_start_music of null) == 0, "music path still degrades gracefully"]

print of "  audio init degrades without builtins: ok"

# ------------------------------------------------------------
# Game-over hint (#19) — the overlay must advertise only the keys the
# game-over handler actually implements (Enter -> play again, Esc -> menu).
# build_gameover_overlay lives in the gfx entry point, which can't load
# headless, so guard the source text itself.
# ------------------------------------------------------------
tp_src is read_text of "tidepool.eigs"
stale_hint is "M to call mate  E to edit/evolve"
live_hint is "Enter: play again   Esc: menu"
assert of [(index_of of [tp_src, stale_hint]) < 0, "game-over hint no longer lists unhandled keys"]
assert of [(index_of of [tp_src, live_hint]) >= 0, "game-over hint lists the real controls"]

print of "  game-over hint text: ok"

print of ""
print of "=== All regressions passed ==="
