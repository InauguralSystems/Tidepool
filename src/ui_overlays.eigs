# Tidepool's diet, pause, game-over and HUD widget trees.
#
# Moved out of tidepool.eigs so a headless test can build the trees the game
# hit-tests (#93); the game builds them once at start-up. Each builder takes
# the screen size instead of reading the entry point's WINDOW_W / WINDOW_H.

import ui

# ---- Diet choice overlay ----

define build_diet_overlay(screen_w, screen_h) as:
    root is ui.panel of ["diet_root", 0, 0, screen_w, screen_h]
    root.bg is null
    root.border is null

    # No full-screen scrim — let the atmospheric ocean background show through
    # so the menu reads as the same pool as the game. The choice panels carry
    # their own backdrops for text contrast.
    overlay_bg is ui.panel of ["diet_bg", 0, 0, screen_w, screen_h]
    overlay_bg.bg is null
    overlay_bg.border is null
    ui.add_child of [root, overlay_bg]

    # Title
    title is ui.label of ["diet_title", 0, 80, "CHOOSE YOUR PATH"]
    title.color is [220, 220, 240]
    title.scale is 4
    # Center: text is 16 chars * 6px * 4 scale = 384px, offset = (800 - 384) / 2 = 208
    title.x is 208
    ui.add_child of [root, title]

    subtitle is ui.label of ["diet_sub", 0, 130, "How will you survive the tidepool?"]
    subtitle.color is [120, 140, 160]
    subtitle.scale is 2
    subtitle.x is floor of ((screen_w - 33 * 12) / 2)
    ui.add_child of [root, subtitle]

    # Herbivore panel
    herb_panel is ui.panel of ["herb_panel", 100, 180, 260, 260]
    herb_panel.bg is [20, 50, 30]
    herb_panel.border is [40, 140, 60]

    herb_title is ui.label of ["herb_title", 30, 20, "HERBIVORE"]
    herb_title.color is [80, 220, 80]
    herb_title.scale is 3
    ui.add_child of [herb_panel, herb_title]

    herb_icon is ui.label of ["herb_icon", 100, 60, "( o )"]
    herb_icon.color is [60, 200, 60]
    herb_icon.scale is 3
    ui.add_child of [herb_panel, herb_icon]

    herb_d1 is ui.label of ["herb_d1", 20, 120, "Filter-feed on plants"]
    herb_d1.color is [140, 200, 140]
    herb_d1.scale is 2
    ui.add_child of [herb_panel, herb_d1]

    herb_d2 is ui.label of ["herb_d2", 20, 145, "Peaceful but cautious"]
    herb_d2.color is [120, 170, 120]
    herb_d2.scale is 2
    ui.add_child of [herb_panel, herb_d2]

    herb_d3 is ui.label of ["herb_d3", 20, 170, "Abundant food sources"]
    herb_d3.color is [120, 170, 120]
    herb_d3.scale is 2
    ui.add_child of [herb_panel, herb_d3]

    herb_btn is ui.button of ["herb_btn", 55, 210, 150, 32, "Choose", null]
    ui.add_child of [herb_panel, herb_btn]

    ui.add_child of [root, herb_panel]

    # Carnivore panel
    carn_panel is ui.panel of ["carn_panel", 440, 180, 260, 260]
    carn_panel.bg is [50, 20, 20]
    carn_panel.border is [180, 50, 50]

    carn_title is ui.label of ["carn_title", 25, 20, "CARNIVORE"]
    carn_title.color is [220, 80, 80]
    carn_title.scale is 3
    ui.add_child of [carn_panel, carn_title]

    carn_icon is ui.label of ["carn_icon", 95, 60, "< X >"]
    carn_icon.color is [200, 60, 60]
    carn_icon.scale is 3
    ui.add_child of [carn_panel, carn_icon]

    carn_d1 is ui.label of ["carn_d1", 20, 120, "Hunt and consume prey"]
    carn_d1.color is [200, 140, 140]
    carn_d1.scale is 2
    ui.add_child of [carn_panel, carn_d1]

    carn_d2 is ui.label of ["carn_d2", 20, 145, "Aggressive and fast"]
    carn_d2.color is [170, 120, 120]
    carn_d2.scale is 2
    ui.add_child of [carn_panel, carn_d2]

    carn_d3 is ui.label of ["carn_d3", 20, 170, "High-risk, high-reward"]
    carn_d3.color is [170, 120, 120]
    carn_d3.scale is 2
    ui.add_child of [carn_panel, carn_d3]

    carn_btn is ui.button of ["carn_btn", 55, 210, 150, 32, "Choose", null]
    ui.add_child of [carn_panel, carn_btn]

    ui.add_child of [root, carn_panel]

    # Hint text
    hint is ui.label of ["diet_hint", 0, 480, "Click a path to begin your journey"]
    hint.color is [100, 110, 130]
    hint.scale is 2
    hint.x is floor of ((screen_w - 34 * 12) / 2)
    ui.add_child of [root, hint]

    return root

# ---- Pause overlay ----

define build_pause_overlay(screen_w, screen_h) as:
    root is ui.panel of ["pause_root", 0, 0, screen_w, screen_h]
    root.bg is null
    root.border is null

    # Center box
    bw is 300
    bh is 310
    bx is floor of ((screen_w - bw) / 2)
    by is floor of ((screen_h - bh) / 2)

    box is ui.panel of ["pause_box", bx, by, bw, bh]
    box.bg is [25, 25, 40]
    box.border is [60, 80, 120]

    title is ui.label of ["pause_title", 0, 20, "PAUSED"]
    title.color is [200, 200, 230]
    title.scale is 4
    # Center: 6 chars * 6px * 4 = 144, offset = (300 - 144) / 2 = 78
    title.x is 78
    ui.add_child of [box, title]

    sep is ui.separator of ["pause_sep", 20, 70, 260, 0]
    ui.add_child of [box, sep]

    resume_btn is ui.button of ["resume_btn", 75, 90, 150, 36, "Resume", null]
    ui.add_child of [box, resume_btn]

    editor_btn is ui.button of ["editor_btn", 75, 140, 150, 36, "Editor", null]
    ui.add_child of [box, editor_btn]

    restart_btn is ui.button of ["restart_btn", 75, 190, 150, 36, "Restart", null]
    ui.add_child of [box, restart_btn]

    quit_btn is ui.button of ["quit_btn", 75, 240, 150, 36, "Quit", null]
    ui.add_child of [box, quit_btn]

    ui.add_child of [root, box]
    return root

# ---- Game over overlay ----

define build_gameover_overlay(screen_w, screen_h) as:
    root is ui.panel of ["go_root", 0, 0, screen_w, screen_h]
    root.bg is null
    root.border is null

    bw is 420
    bh is 400
    bx is floor of ((screen_w - bw) / 2)
    by is floor of ((screen_h - bh) / 2)

    box is ui.panel of ["go_box", bx, by, bw, bh]
    box.bg is [40, 15, 15]
    box.border is [140, 40, 40]

    title is ui.label of ["go_title", 0, 15, "GAME OVER"]
    title.color is [220, 60, 60]
    title.scale is 4
    title.x is floor of ((bw - 9 * 24) / 2)
    ui.add_child of [box, title]

    sep is ui.separator of ["go_sep", 20, 58, bw - 40, 0]
    ui.add_child of [box, sep]

    reason is ui.label of ["go_reason", 30, 72, ""]
    reason.color is [200, 160, 160]
    reason.scale is 2
    ui.add_child of [box, reason]

    # Left column stats
    score_lbl is ui.label of ["go_score", 30, 100, "Score: 0"]
    score_lbl.color is [220, 220, 220]
    score_lbl.scale is 2
    ui.add_child of [box, score_lbl]

    hi_lbl is ui.label of ["go_hiscore", 30, 124, "Best: 0"]
    hi_lbl.color is [255, 220, 100]
    hi_lbl.scale is 2
    ui.add_child of [box, hi_lbl]

    tier_lbl is ui.label of ["go_tier", 30, 152, "Tier: 0"]
    tier_lbl.color is [255, 200, 50]
    tier_lbl.scale is 2
    ui.add_child of [box, tier_lbl]

    dna_lbl is ui.label of ["go_dna", 30, 176, "DNA: 0"]
    dna_lbl.color is [100, 200, 255]
    dna_lbl.scale is 2
    ui.add_child of [box, dna_lbl]

    # Right column stats
    food_lbl is ui.label of ["go_food", 230, 100, "Plants: 0"]
    food_lbl.color is [100, 200, 100]
    food_lbl.scale is 2
    ui.add_child of [box, food_lbl]

    meat_lbl is ui.label of ["go_meat", 230, 124, "Meat: 0"]
    meat_lbl.color is [200, 100, 100]
    meat_lbl.scale is 2
    ui.add_child of [box, meat_lbl]

    upgrades_lbl is ui.label of ["go_upgrades", 230, 152, ""]
    upgrades_lbl.color is [180, 180, 200]
    upgrades_lbl.scale is 2
    ui.add_child of [box, upgrades_lbl]

    time_lbl is ui.label of ["go_time", 230, 176, ""]
    time_lbl.color is [180, 180, 200]
    time_lbl.scale is 2
    ui.add_child of [box, time_lbl]

    # New best indicator (hidden by default)
    newbest_lbl is ui.label of ["go_newbest", 0, 210, ""]
    newbest_lbl.color is [255, 255, 80]
    newbest_lbl.scale is 3
    ui.add_child of [box, newbest_lbl]

    sep2 is ui.separator of ["go_sep2", 20, 240, bw - 40, 0]
    ui.add_child of [box, sep2]

    # Hint
    hint is ui.label of ["go_hint", 30, 252, "Enter: play again   Esc: menu"]
    hint.color is [100, 110, 130]
    hint.scale is 1
    ui.add_child of [box, hint]

    restart_btn is ui.button of ["go_restart_btn", 50, 310, 140, 36, "Play Again", null]
    ui.add_child of [box, restart_btn]

    quit_btn is ui.button of ["go_quit_btn", 230, 310, 140, 36, "Quit", null]
    ui.add_child of [box, quit_btn]

    ui.add_child of [root, box]
    return root

# ---- HUD panel (bottom strip) ----

define build_hud_panel(screen_w, screen_h, hud_h) as:
    hud is ui.panel of ["hud_root", 0, screen_h - hud_h, screen_w, hud_h]
    hud.bg is [15, 15, 25]
    hud.border is null

    # Top separator line
    sep is ui.separator of ["hud_sep", 0, 0, screen_w, 0]
    sep.color is [60, 80, 120]
    ui.add_child of [hud, sep]

    # Energy section
    energy_lbl is ui.label of ["hud_energy_lbl", 10, 5, "ENERGY"]
    energy_lbl.color is [120, 120, 140]
    energy_lbl.scale is 1
    ui.add_child of [hud, energy_lbl]

    energy_bar is ui.progress_bar of ["hud_energy_bar", 10, 16, 200, 0.5]
    ui.add_child of [hud, energy_bar]

    energy_val is ui.label of ["hud_energy_val", 10, 32, "100"]
    energy_val.color is [50, 200, 50]
    energy_val.scale is 2
    ui.add_child of [hud, energy_val]

    # Score badge
    score_badge is ui.badge of ["hud_score", 230, 8, "Score: 0", [60, 60, 90]]
    ui.add_child of [hud, score_badge]

    # DNA badge
    dna_badge is ui.badge of ["hud_dna", 230, 30, "DNA: 0", [30, 60, 80]]
    ui.add_child of [hud, dna_badge]

    # Tier badge
    tier_badge is ui.badge of ["hud_tier", 380, 8, "Tier 0", [80, 60, 20]]
    ui.add_child of [hud, tier_badge]

    # Food counter
    food_badge is ui.badge of ["hud_food", 380, 30, "Food: 0", [20, 60, 20]]
    ui.add_child of [hud, food_badge]

    # Upgrade buttons
    spd_btn is ui.button of ["hud_spd", 520, 5, 80, 22, "Spd [5]", null]
    ui.add_child of [hud, spd_btn]

    sns_btn is ui.button of ["hud_sns", 520, 30, 80, 22, "Sns [5]", null]
    ui.add_child of [hud, sns_btn]

    spk_btn is ui.button of ["hud_spk", 620, 5, 80, 22, "Spk [5]", null]
    ui.add_child of [hud, spk_btn]

    # Upgrade levels display
    lvl_lbl is ui.label of ["hud_lvl", 620, 32, "S:0 N:0 K:0"]
    lvl_lbl.color is [160, 160, 180]
    lvl_lbl.scale is 1
    ui.add_child of [hud, lvl_lbl]

    # Alignment bar
    align_lbl is ui.label of ["hud_align_lbl", 720, 5, "ALIGN"]
    align_lbl.color is [120, 120, 140]
    align_lbl.scale is 1
    ui.add_child of [hud, align_lbl]

    align_bar is ui.progress_bar of ["hud_align", 720, 16, 60, 0.5]
    ui.add_child of [hud, align_bar]

    # Message line
    msg_lbl is ui.label of ["hud_msg", 10, 48, ""]
    msg_lbl.color is [255, 255, 100]
    msg_lbl.scale is 2
    ui.add_child of [hud, msg_lbl]

    return hud
