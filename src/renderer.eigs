# ============================================================
# Tidepool — Terminal Renderer (Pure EigenScript)
# ============================================================
# Builds screen as a list of strings, joins once, writes once.
# No C rendering builtins — uses only join, write, flush.

load_file of "src/constants.eigs"

ESC is chr of 27

# ============================================================
# Render game state to terminal
# ============================================================

define render_game(game, screen_w, screen_h) as:
    # View window centered on player
    view_w is screen_w * 0.5
    view_h is screen_h * 0.5
    half_vw is view_w / 2.0
    half_vh is view_h / 2.0

    # Build flat screen buffer
    buf_size is screen_w * screen_h
    buf is []
    buf_colors is []
    for i in range of buf_size:
        append of [buf, " "]
        append of [buf_colors, 0]

    # Project entity to screen index
    define project(wx, wy) as:
        dx is torus_delta of [game.px, wx, game.world_w]
        dy is torus_delta of [game.py, wy, game.world_h]
        col is floor of ((dx + half_vw) / view_w * screen_w)
        row is floor of ((dy + half_vh) / view_h * screen_h)
        if col >= 0:
            if col < screen_w:
                if row >= 0:
                    if row < screen_h:
                        return row * screen_w + col
        return -1

    # Project food
    for i in range of (len of game.food):
        f is game.food[i]
        if f.active == 1:
            idx is project of [f.px, f.py]
            if idx >= 0:
                set_at of [buf, idx, "."]
                set_at of [buf_colors, idx, 32]

    # Project predators
    for i in range of (len of game.predators):
        p is game.predators[i]
        if p.active == 1:
            idx is project of [p.px, p.py]
            if idx >= 0:
                set_at of [buf, idx, "X"]
                set_at of [buf_colors, idx, 31]

    # Project meat
    for i in range of (len of game.meat):
        m is game.meat[i]
        if m.active == 1:
            idx is project of [m.px, m.py]
            if idx >= 0:
                set_at of [buf, idx, "m"]
                set_at of [buf_colors, idx, 35]

    # Player at center
    center is floor of (screen_h / 2) * screen_w + floor of (screen_w / 2)
    set_at of [buf, center, "@"]
    set_at of [buf_colors, center, 37]

    # Build output as list of fragments, join once
    parts is []
    append of [parts, f"{ESC}[H"]
    prev_color is 0
    for row in range of screen_h:
        for col in range of screen_w:
            idx is row * screen_w + col
            c is buf_colors[idx]
            if c != prev_color:
                if c > 0:
                    append of [parts, f"{ESC}[{c}m"]
                else:
                    append of [parts, f"{ESC}[0m"]
                prev_color is c
            append of [parts, buf[idx]]
        append of [parts, "\n"]

    # HUD
    status is game_status of game
    append of [parts, f"{ESC}[0m{ESC}[33m E:{status.energy} S:{status.score} DNA:{status.dna} T:{status.tier} F:{status.food_eaten}"]
    if (len of status.message) > 0:
        append of [parts, f" | {status.message}"]
    append of [parts, f"{ESC}[0m"]

    # Single write
    write of (join of [parts, ""])
    flush of null
