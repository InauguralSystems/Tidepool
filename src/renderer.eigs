# ============================================================
# Tidepool — Terminal Renderer (Native)
# ============================================================
# Uses screen_render C builtin for fast terminal output.
# Game logic builds entity list, C does the pixel work.

load_file of "src/constants.eigs"

# ============================================================
# Build renderable entity list from game state
# ============================================================

define render_game(game, screen_w, screen_h) as:
    entities is []

    # Food — green dots
    for i in range of (len of game.food):
        f is game.food[i]
        if f.active == 1:
            append of [entities, [f.px, f.py, ".", 32]]

    # Meat — magenta
    for i in range of (len of game.meat):
        m is game.meat[i]
        if m.active == 1:
            append of [entities, [m.px, m.py, "m", 35]]

    # Predators — red X
    for i in range of (len of game.predators):
        p is game.predators[i]
        if p.active == 1:
            append of [entities, [p.px, p.py, "X", 31]]

    # Poison clouds — yellow
    for i in range of (len of game.poison_clouds):
        pc is game.poison_clouds[i]
        if pc.active == 1:
            append of [entities, [pc.px, pc.py, "*", 33]]

    # Player — white @, always rendered
    append of [entities, [game.px, game.py, "@", 37]]

    # Render all entities via C builtin
    screen_render of [
        entities, screen_w, screen_h,
        game.px, game.py,
        game.world_w, game.world_h
    ]

    # HUD line
    status is game_status of game
    hud is f" E:{status.energy} S:{status.score} DNA:{status.dna} T:{status.tier} F:{status.food_eaten}"
    if (len of status.message) > 0:
        hud is hud + f" | {status.message}"
    write of f"\033[33m{hud}\033[0m"
    flush of null
