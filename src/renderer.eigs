# ============================================================
# Tidepool — SDL2 Graphical Renderer
# ============================================================
# Draws the game world using gfx_* builtins.

load_file of "src/constants.eigs"
load_file of "src/math_utils.eigs"
load_file of "src/draw.eigs"

# Rendering constants
HUD_HEIGHT is 60

# Dynamic camera zoom state
_cam_ppu is 20.0
_cam_ppu_target is 20.0

# Color palette
BG_R is 8
BG_G is 16
BG_B is 32

# ============================================================
# Dynamic camera zoom
# ============================================================

define update_camera_zoom(game) as:
    tier_ppu is [28, 24, 20, 17, 14]
    tier is clamp of [game.scale_tier, 0, 4]
    ppu is tier_ppu[tier]
    ppu is ppu / (1.0 + game.mass * 0.008)
    # Dramatic zoom-out during tier transition
    if game.tier_transition_timer > 60:
        ppu is ppu * 0.7
    if ppu < 10.0:
        ppu is 10.0
    _cam_ppu_target is ppu
    # Smooth interpolation
    _cam_ppu is _cam_ppu + (_cam_ppu_target - _cam_ppu) * 0.03

define get_ppu() as:
    return _cam_ppu

# ============================================================
# Caustic light background
# ============================================================

# Drifting plankton — tiny faint motes that drift with the current and twinkle,
# so the empty water feels alive. Procedural (no state): positions derive from
# the index + tick and wrap around the screen.
define draw_plankton(screen_w, game_h, tick, current_angle) as:
    cxd is cos of current_angle
    cyd is sin of current_angle
    drift is tick * 0.12
    for i in range of 36:
        rawx is (i * 211 + 23) + cxd * drift + (sin of (i * 1.1 + tick * 0.015)) * 4.0
        rawy is (i * 137 + 41) + cyd * drift * 0.5 + (cos of (i * 0.9 + tick * 0.02)) * 4.0
        px is floor of (rawx - (floor of (rawx / screen_w)) * screen_w)
        py is floor of (rawy - (floor of (rawy / game_h)) * game_h)
        tw is (sin of (tick * 0.05 + i * 1.3)) * 0.5 + 0.5
        draw_circle of [px, py, 1, 150, 205, 225, 14 + floor of (tw * 26)]

# Vertical depth gradient — surface light at the top fading into deep dark at
# the bottom, so the pool reads as having depth instead of a flat fill.
define draw_ocean_depth(screen_w, game_h) as:
    bands is 24
    bh is floor of (game_h / bands) + 1
    for b in range of bands:
        t is (b + 0.0) / bands
        k is 1.0 - t
        y is floor of (t * game_h)
        draw_rect of [0, y, screen_w, bh, floor of (BG_R + k * 7), floor of (BG_G + k * 16), floor of (BG_B + k * 28)]

define draw_caustics(screen_w, game_h, tick) as:
    for i in range of 4:
        y_base is game_h / 2 + (sin of (tick * 0.02 + i * 1.5)) * (game_h * 0.3)
        # Brighter near the surface, fading with depth; gentle shimmer, so the
        # ripples feel incidental rather than busy.
        depth_k is 1.0 - clamp of [y_base / game_h, 0.0, 1.0]
        ca is floor of ((20 + ((sin of (tick * 0.03 + i)) * 0.5 + 0.5) * 26) * (0.4 + depth_k * 0.6))
        for x_step in range of (floor of (screen_w / 8)):
            px is x_step * 8
            py is y_base + (sin of (px * 0.03 + tick * 0.04 + i)) * 8
            px2 is px + 8
            py2 is y_base + (sin of (px2 * 0.03 + tick * 0.04 + i)) * 8
            draw_line of [px, floor of py, px2, floor of py2, 45, 80, 105, ca]

# ============================================================
# Particle system — lightweight effect particles
# ============================================================
# Max ~100 particles for Pentium performance

_particles is []

define update_particles() as:
    alive is []
    for i in range of (len of _particles):
        p is _particles[i]
        p.x is p.x + p.vx
        p.y is p.y + p.vy
        p.life is p.life - 1
        if p.life > 0:
            append of [alive, p]
    _particles is alive

define draw_particles(cam_x, cam_y, screen_w, game_h, world_w, world_h) as:
    for i in range of (len of _particles):
        p is _particles[i]
        pos is world_to_screen of [p.x, p.y, cam_x, cam_y, screen_w, game_h, world_w, world_h]
        if pos[0] < -10 or pos[0] > screen_w + 10 or pos[1] < -10 or pos[1] > game_h + 10:
            continue
        alpha_frac is p.life / p.max_life
        sz is floor of (p.size * alpha_frac + 1)
        if sz < 1:
            sz is 1
        # Fade color toward dark
        cr is floor of (p.r * alpha_frac)
        cg is floor of (p.g * alpha_frac)
        cb is floor of (p.b * alpha_frac)
        draw_circle of [pos[0], pos[1], sz, cr, cg, cb]

define spawn_death_burst(x, y, palette_idx) as:
    pal is get_palette of palette_idx
    for i in range of 10:
        angle is (random of null) * 6.283
        speed is 0.5 + (random of null) * 1.5
        p is {
            "x": x, "y": y,
            "vx": (cos of angle) * speed * 0.05,
            "vy": (sin of angle) * speed * 0.05,
            "life": 20 + (random_int of [0, 14]),
            "max_life": 35,
            "r": pal.otr, "g": pal.otg, "b": pal.otb,
            "size": 3
        }
        if (len of _particles) < 100:
            append of [_particles, p]

define spawn_collection_sparkle(x, y) as:
    for i in range of 4:
        angle is (random of null) * 6.283
        speed is 0.3 + (random of null) * 0.5
        p is {
            "x": x, "y": y,
            "vx": (cos of angle) * speed * 0.03,
            "vy": (sin of angle) * speed * 0.03,
            "life": 10 + (random_int of [0, 8]),
            "max_life": 18,
            "r": 255, "g": 255, "b": 100,
            "size": 2
        }
        if (len of _particles) < 100:
            append of [_particles, p]

define spawn_wake(x, y, angle) as:
    p is {
        "x": x, "y": y,
        "vx": 0 - (cos of angle) * 0.02,
        "vy": 0 - (sin of angle) * 0.02,
        "life": 15, "max_life": 15,
        "r": 60, "g": 100, "b": 140,
        "size": 2
    }
    if (len of _particles) < 100:
        append of [_particles, p]

define spawn_collision_flash(x, y) as:
    for i in range of 5:
        angle is i * 1.257
        p is {
            "x": x, "y": y,
            "vx": (cos of angle) * 0.04,
            "vy": (sin of angle) * 0.04,
            "life": 8, "max_life": 8,
            "r": 255, "g": 255, "b": 255,
            "size": 4
        }
        if (len of _particles) < 100:
            append of [_particles, p]

# ============================================================
# World-to-screen coordinate conversion
# ============================================================

define world_to_screen(wx, wy, cam_x, cam_y, screen_w, screen_h, world_w, world_h) as:
    dx is torus_delta of [cam_x, wx, world_w]
    dy is torus_delta of [cam_y, wy, world_h]
    sx is floor of (screen_w / 2 + dx * _cam_ppu)
    sy is floor of (screen_h / 2 + dy * _cam_ppu)
    return [sx, sy]

# ============================================================
# Segment position along the creature spine
# ============================================================
# Returns [sx, sy] — screen position of body segment `seg`
# relative to head at (cx, cy), stepping backward along the
# forward axis by `spacing` per segment.

define segment_position(seg, cx, cy, spacing, fx, fy, spine_bend) as:
    # Lateral offset from spine bends: each joint shifts the segment sideways
    lx is 0 - fy
    ly is fx
    lat_offset is 0.0
    if spine_bend != null and seg > 0:
        joints is seg
        if joints > (len of spine_bend):
            joints is len of spine_bend
        for j in range of joints:
            lat_offset is lat_offset + (spine_bend[j] - 1) * spacing * 0.3
    x is cx - fx * spacing * seg + lx * lat_offset
    y is cy - fy * spacing * seg + ly * lat_offset
    return [floor of x, floor of y]

# ============================================================
# Draw a creature body from a CreatureSpec
# ============================================================
# spec      — creature spec dict
# sx, sy    — screen center position
# angle     — heading in radians
# radius    — pixel radius of head segment
# tick      — animation tick counter
# spikes_lvl — mutation spike level (0 for NPCs)

# One translucent, lit-from-within cell blob — the building block of the
# bioluminescent look. Layers (renderer has alpha blending on): a soft outer
# bloom, a translucent membrane, an inner glow, a bright nucleus, and an
# upper-left sheen. Replaces the old flat circle + dark core (which read as a
# solid ball). Overlapping segments stack their low-alpha blooms into one
# cohesive glow.
define draw_cell_blob(cx, cy, r, pal, pulse) as:
    rr is clamp of [r, 3, 60]
    # Translucent membrane body. No per-segment bloom — the creature-wide
    # glow (draw_body_glow) provides the halo, so segments melt together
    # instead of each carrying its own ring.
    draw_circle of [cx, cy, rr, pal.otr, pal.otg, pal.otb, 175]
    # Lit-from-within inner glow — breathes with the pulse
    ig_a is 95 + floor of (pulse * 55)
    draw_circle of [cx, cy, floor of (rr * 0.6), pal.ar, pal.ag, pal.ab, ig_a]
    # Bright nucleus — brightness pulses
    nr is clamp of [floor of (rr * 0.3), 2, rr]
    nuc_a is 175 + floor of (pulse * 70)
    if nuc_a > 255:
        nuc_a is 255
    draw_circle of [cx, cy, nr, pal.er, pal.eg, pal.eb, nuc_a]
    # Membrane sheen (upper-left specular)
    hr is clamp of [floor of (rr * 0.38), 2, rr]
    draw_circle of [cx - floor of (rr * 0.33), cy - floor of (rr * 0.33), hr, 255, 255, 255, 55]

# One soft halo behind the whole creature so its segments read as a single
# cohesive cell. Smooth radial falloff via stacked low-alpha circles (in the
# muted outer-body colour so it fades into the background instead of ringing);
# the inner accent layer pulses so the cell glows like it's alive.
define draw_body_glow(cx, cy, r, pal, pulse) as:
    draw_circle of [cx, cy, floor of (r * 1.5), pal.otr, pal.otg, pal.otb, 9]
    draw_circle of [cx, cy, floor of (r * 1.15), pal.otr, pal.otg, pal.otb, 13]
    draw_circle of [cx, cy, floor of (r * 0.85), pal.otr, pal.otg, pal.otb, 17]
    core_a is 14 + floor of (pulse * 16)
    draw_circle of [cx, cy, floor of (r * 0.6), pal.ar, pal.ag, pal.ab, core_a]

define draw_creature_body(spec, sx, sy, angle, radius, tick, spikes_lvl) as:
    # Get palette colors
    pal is get_palette of spec.palette
    fx is cos of angle
    fy is sin of angle
    lx is 0 - fy
    ly is fx

    # Segment spacing and sizing
    seg_count is clamp of [spec.body_segments, 1, CREATURE_MAX_SEGMENTS]
    seg_spacing is clamp of [radius - 1, 6, 40]
    max_sockets is seg_count * 2
    if max_sockets > CREATURE_MAX_SOCKETS:
        max_sockets is CREATURE_MAX_SOCKETS

    # Gentle "breathing" pulse (0..1), shared by the body glow and each blob.
    pulse is (sin of (tick * 0.08)) * 0.5 + 0.5

    # Unifying glow behind the whole body so segments read as one cell.
    body_len is (seg_count - 1) * seg_spacing
    gcx is sx - floor of (fx * body_len * 0.5)
    gcy is sy - floor of (fy * body_len * 0.5)
    glow_r is radius + floor of (body_len * 0.5)
    draw_body_glow of [gcx, gcy, glow_r, pal, pulse]

    # Draw body segments back-to-front (tail first)
    i is seg_count - 1
    loop while i >= 0:
        seg_pos is segment_position of [i, sx, sy, seg_spacing, fx, fy, spec.spine_bend]
        sr is clamp of [radius - i * 2, 5, radius]

        # Wobble animation
        wobble is (sin of (tick * 0.12 + i * 1.0)) * 1.0
        scx is seg_pos[0] + floor of wobble
        scy is seg_pos[1]

        # Body shape variation — each piece is a lit-from-within blob.
        if spec.body_shape == SHAPE_WIDE:
            draw_cell_blob of [scx - 2, scy, sr, pal, pulse]
            draw_cell_blob of [scx + 2, scy, sr, pal, pulse]
        elif spec.body_shape == SHAPE_TALL:
            draw_cell_blob of [scx, scy - 2, sr, pal, pulse]
            draw_cell_blob of [scx, scy + 2, sr, pal, pulse]
        elif spec.body_shape == SHAPE_SHELL:
            draw_cell_blob of [scx, scy, sr + 1, pal, pulse]
            if sr > 4:
                # faint inner accent ring for the shell look
                draw_circle of [scx, scy, clamp of [sr - 3, 3, sr], pal.ar, pal.ag, pal.ab, 90]
        else:
            draw_cell_blob of [scx, scy, sr, pal, pulse]

        i is i - 1

    # Pattern overlay on head segment
    if spec.pattern == PATTERN_SPOTS:
        ps is clamp of [floor of (radius / 6), 2, 5]
        draw_circle of [sx - floor of (radius / 3), sy + floor of (radius / 4), ps, pal.ar, pal.ag, pal.ab]
        draw_circle of [sx + floor of (radius / 3), sy - floor of (radius / 4), ps, pal.ar, pal.ag, pal.ab]
    elif spec.pattern == PATTERN_STRIPES:
        half is floor of (radius / 2)
        draw_line of [sx - half, sy - 2, sx + half, sy - 2, pal.ar, pal.ag, pal.ab]
        draw_line of [sx - half, sy + 2, sx + half, sy + 2, pal.ar, pal.ag, pal.ab]
    elif spec.pattern == PATTERN_CORE:
        cr is clamp of [floor of (radius / 3), 3, 10]
        draw_circle of [sx, sy, cr, pal.ar, pal.ag, pal.ab]

    # Appendages
    for ai in range of max_sockets:
        app_type is spec.appendages[ai]
        if app_type != APPENDAGE_NONE:
            seg is clamp of [spec.appendage_anchor[ai], 0, seg_count - 1]
            apos is segment_position of [seg, sx, sy, seg_spacing, fx, fy, spec.spine_bend]
            side is socket_side of ai
            # Appendage base position offset laterally
            base_x is apos[0] + floor of (lx * side * radius * 0.5)
            base_y is apos[1] + floor of (ly * side * radius * 0.5)
            # Appendage mid point — extends outward
            mid_x is base_x + floor of (lx * side * (radius * 0.4 + 6))
            mid_y is base_y + floor of (ly * side * (radius * 0.4 + 6))

            # Draw the appendage stalk
            draw_line of [base_x, base_y, mid_x, mid_y, pal.ar, pal.ag, pal.ab]

            if app_type == APPENDAGE_FIN:
                # Fin: wavy V-shape
                wave is (sin of (tick * 0.15 + ai * 1.0)) * 3.0
                tip_x is mid_x + floor of (fx * wave)
                tip_y is mid_y + floor of (fy * wave)
                draw_line of [mid_x, mid_y, tip_x, tip_y, pal.er, pal.eg, pal.eb]
                draw_line of [mid_x, mid_y, tip_x + floor of (fx * 6), tip_y + floor of (fy * 6), pal.er, pal.eg, pal.eb]
            elif app_type == APPENDAGE_CLAW:
                # Claw: forked lines
                tip_x is mid_x + floor of (lx * side * 8)
                tip_y is mid_y + floor of (ly * side * 8)
                draw_line of [mid_x, mid_y, tip_x, tip_y, pal.ar, pal.ag, pal.ab]
                draw_line of [tip_x, tip_y, tip_x + floor of (fx * 5 + lx * side * 3), tip_y + floor of (fy * 5 + ly * side * 3), pal.ar, pal.ag, pal.ab]
                draw_line of [tip_x, tip_y, tip_x + floor of (0 - fx * 3 + lx * side * 4), tip_y + floor of (0 - fy * 3 + ly * side * 4), pal.ar, pal.ag, pal.ab]
            elif app_type == APPENDAGE_CILIA:
                # Cilia: three wavy tendrils
                for w in range of 3:
                    wave is (sin of (tick * 0.2 + w * 1.5)) * 2.0
                    draw_line of [mid_x, mid_y, mid_x + floor of (fx * (w - 1) * 3 + lx * wave), mid_y + floor of (fy * (w - 1) * 3 + ly * wave), pal.ar, pal.ag, pal.ab]
            elif app_type == APPENDAGE_POISON:
                # Poison: small dot at end
                draw_circle of [mid_x, mid_y, 2, 120, 255, 60]
            elif app_type == APPENDAGE_ELECTRIC:
                # Electric: small dot
                draw_circle of [mid_x, mid_y, 2, 100, 180, 255]

    # Placed spikes from spec
    for si in range of max_sockets:
        if spec.spikes[si] == 1:
            seg is clamp of [spec.spike_anchor[si], 0, seg_count - 1]
            spos is segment_position of [seg, sx, sy, seg_spacing, fx, fy, spec.spine_bend]
            side is socket_side of si
            sp_in is clamp of [radius - 2, 3, radius]
            sp_out is radius + 6
            x1 is spos[0] + floor of (lx * side * sp_in)
            y1 is spos[1] + floor of (ly * side * sp_in)
            x2 is spos[0] + floor of (lx * side * sp_out)
            y2 is spos[1] + floor of (ly * side * sp_out)
            draw_line of [x1, y1, x2, y2, pal.ar, pal.ag, pal.ab]

    # Mutation spikes (radial, from upgrade system)
    if spikes_lvl > 0:
        sc is 6 + spikes_lvl * 2
        for si in range of sc:
            sa is si * 6.283 / sc
            sp_in is clamp of [radius - 3, 3, radius]
            sp_out is radius + 4 + spikes_lvl * 2
            x1 is sx + floor of ((cos of sa) * sp_in)
            y1 is sy + floor of ((sin of sa) * sp_in)
            x2 is sx + floor of ((cos of sa) * sp_out)
            y2 is sy + floor of ((sin of sa) * sp_out)
            draw_line of [x1, y1, x2, y2, pal.ar, pal.ag, pal.ab]

    # Eyes
    for ei in range of max_sockets:
        if spec.eyes[ei] == 1:
            seg is clamp of [spec.eye_anchor[ei], 0, seg_count - 1]
            epos is segment_position of [seg, sx, sy, seg_spacing, fx, fy, spec.spine_bend]
            side is socket_side of ei
            eye_offset is clamp of [floor of (radius / 3), 4, 16]
            ex is epos[0] + floor of (lx * side * eye_offset)
            ey is epos[1] + floor of (ly * side * eye_offset)
            er is clamp of [floor of (radius / 5), 2, 6]
            # Eye white
            draw_circle of [ex, ey, er, pal.er, pal.eg, pal.eb]
            # Pupil (dark, offset in facing direction)
            px is ex + floor of (fx * er * 0.4)
            py is ey + floor of (fy * er * 0.4)
            pr is clamp of [floor of (er / 2), 1, 3]
            draw_circle of [px, py, pr, 18, 24, 28]

    # Mouth
    mx is sx + floor of (fx * radius * 0.7)
    my is sy + floor of (fy * radius * 0.7)
    ms is clamp of [floor of (radius / 4), 3, 10]
    if spec.mouth_type == MOUTH_FILTER:
        # Baleen: three horizontal lines across the front
        draw_line of [mx - floor of (lx * ms), my - floor of (ly * ms), mx + floor of (lx * ms), my + floor of (ly * ms), pal.ar, pal.ag, pal.ab]
        draw_line of [mx + floor of (fx * 2) - floor of (lx * (ms - 2)), my + floor of (fy * 2) - floor of (ly * (ms - 2)), mx + floor of (fx * 2) + floor of (lx * (ms - 2)), my + floor of (fy * 2) + floor of (ly * (ms - 2)), pal.ar, pal.ag, pal.ab]
    elif spec.mouth_type == MOUTH_JAW:
        # V-shape jaw
        jaw_tip_x is mx + floor of (fx * ms)
        jaw_tip_y is my + floor of (fy * ms)
        jaw_l_x is mx - floor of (fx * ms * 0.5) + floor of (lx * ms)
        jaw_l_y is my - floor of (fy * ms * 0.5) + floor of (ly * ms)
        jaw_r_x is mx - floor of (fx * ms * 0.5) - floor of (lx * ms)
        jaw_r_y is my - floor of (fy * ms * 0.5) - floor of (ly * ms)
        draw_line of [jaw_tip_x, jaw_tip_y, jaw_l_x, jaw_l_y, pal.ar, pal.ag, pal.ab]
        draw_line of [jaw_tip_x, jaw_tip_y, jaw_r_x, jaw_r_y, pal.ar, pal.ag, pal.ab]
    elif spec.mouth_type == MOUTH_PROBOSCIS:
        # Proboscis: extending line with tip dot
        prob_x is mx + floor of (fx * ms * 2)
        prob_y is my + floor of (fy * ms * 2)
        draw_line of [mx, my, prob_x, prob_y, pal.ar, pal.ag, pal.ab]
        draw_circle of [prob_x, prob_y, clamp of [floor of (ms / 3), 1, 3], pal.ar, pal.ag, pal.ab]

# ============================================================
# Legacy draw_creature — simple fallback (kept for compatibility)
# ============================================================

define draw_creature(sx, sy, angle, radius, r, g, b) as:
    px_radius is floor of (radius * _cam_ppu)
    if px_radius < 3:
        px_radius is 3

    # Body circle
    draw_circle of [sx, sy, px_radius, r, g, b]

    # Direction indicator (line from center forward)
    fx is cos of angle
    fy is sin of angle
    tip_x is floor of (sx + fx * px_radius * 1.3)
    tip_y is floor of (sy + fy * px_radius * 1.3)
    draw_line of [sx, sy, tip_x, tip_y, 255, 255, 255]

# ============================================================
# Water current visualization — faint parallax lines.
# ============================================================

define draw_water_current(game, cam_x, cam_y, screen_w, game_h) as:
    cx_dir is cos of game.current_angle
    cy_dir is sin of game.current_angle
    for i in range of 12:
        wx is cam_x + (i - 6) * 3.0
        wy is cam_y + (sin of (wx * 0.3 + game.tick * 0.01)) * 5.0
        pos is world_to_screen of [wx, wy, cam_x, cam_y, screen_w, game_h, game.world_w, game.world_h]
        if pos[0] > 0 and pos[0] < screen_w and pos[1] > 0 and pos[1] < game_h:
            ex is floor of (pos[0] + cx_dir * 15)
            ey is floor of (pos[1] + cy_dir * 15)
            draw_line of [pos[0], pos[1], ex, ey, 20, 35, 55]

# ============================================================
# World entities — food, meat, predators.
# ============================================================

define draw_entities(game, cam_x, cam_y, screen_w, game_h) as:
    # Draw food
    for i in range of (len of game.food):
        f is game.food[i]
        if f.active == 1:
            dx is torus_delta of [cam_x, f.px, game.world_w]
            dy is torus_delta of [cam_y, f.py, game.world_h]
            sx is floor of (screen_w / 2 + dx * _cam_ppu)
            sy is floor of (game_h / 2 + dy * _cam_ppu)
            if sx > -10 and sx < screen_w + 10 and sy > -10 and sy < game_h + 10:
                # Glowing bioluminescent morsel: soft pulsing halo + body + core
                shimmer is (sin of (game.tick * 0.1 + i * 0.7)) * 0.5 + 0.5
                ga is 28 + floor of (shimmer * 26)
                draw_circle of [sx, sy, 8, 90, 230, 130, ga]
                draw_circle of [sx, sy, 4, 130, 240, 150, 225]
                draw_circle of [sx, sy, 2, 225, 255, 210, 255]

    # Draw meat
    for i in range of (len of game.meat):
        m is game.meat[i]
        if m.active == 1:
            dx is torus_delta of [cam_x, m.px, game.world_w]
            dy is torus_delta of [cam_y, m.py, game.world_h]
            sx is floor of (screen_w / 2 + dx * _cam_ppu)
            sy is floor of (game_h / 2 + dy * _cam_ppu)
            if sx > -10 and sx < screen_w + 10 and sy > -10 and sy < game_h + 10:
                # Warm glowing chunk
                draw_circle of [sx, sy, 9, 200, 70, 70, 36]
                draw_circle of [sx, sy, 5, 220, 95, 90, 220]
                draw_circle of [sx, sy, 2, 255, 185, 170, 255]

    # Draw predators with full creature bodies
    for i in range of (len of game.predators):
        p is game.predators[i]
        if p.active == 1:
            dx is torus_delta of [cam_x, p.px, game.world_w]
            dy is torus_delta of [cam_y, p.py, game.world_h]
            sx is floor of (screen_w / 2 + dx * _cam_ppu)
            sy is floor of (game_h / 2 + dy * _cam_ppu)
            if sx > -20 and sx < screen_w + 20 and sy > -20 and sy < game_h + 20:
                pred_radius is clamp of [floor of (8 + p.size * 4), 6, 24]
                # LOD: very small on screen -> simple circle
                if pred_radius < 8:
                    pal is get_palette of p.spec.palette
                    draw_circle of [sx, sy, pred_radius, pal.otr, pal.otg, pal.otb]
                else:
                    draw_creature_body of [p.spec, sx, sy, p.angle, pred_radius, game.tick, 0]

# ============================================================
# Combat entities — poison clouds, electric bolts, epic cells, part drops
# ============================================================

define draw_combat_entities(game, cam_x, cam_y, screen_w, game_h) as:
    # Poison clouds — green circles
    for i in range of (len of game.poison_clouds):
        pc is game.poison_clouds[i]
        if pc.active == 1:
            pos is world_to_screen of [pc.px, pc.py, cam_x, cam_y, screen_w, game_h, game.world_w, game.world_h]
            if pos[0] > -80 and pos[0] < screen_w + 80 and pos[1] > -80 and pos[1] < game_h + 80:
                px_r is floor of (pc.radius * _cam_ppu)
                if px_r < 2:
                    px_r is 2
                # Multiple concentric rings for cloud effect
                alpha_frac is pc.lifetime / 120.0
                cr is floor of (40 * alpha_frac)
                cg is floor of (180 * alpha_frac)
                cb is floor of (40 * alpha_frac)
                draw_circle of [pos[0], pos[1], px_r, cr, cg, cb]
                if px_r > 4:
                    draw_circle of [pos[0], pos[1], floor of (px_r * 0.6), floor of (cr * 0.7), floor of (cg * 0.7), floor of (cb * 0.7)]

    # Electric bolts — white line from source to target
    for i in range of (len of game.electric_bolts):
        eb is game.electric_bolts[i]
        if eb.active == 1:
            sp is world_to_screen of [eb.sx, eb.sy, cam_x, cam_y, screen_w, game_h, game.world_w, game.world_h]
            tp is world_to_screen of [eb.tx, eb.ty, cam_x, cam_y, screen_w, game_h, game.world_w, game.world_h]
            # Flicker: alternate between white and blue
            if eb.lifetime % 2 == 0:
                draw_line of [sp[0], sp[1], tp[0], tp[1], 200, 220, 255]
            else:
                draw_line of [sp[0], sp[1], tp[0], tp[1], 100, 160, 255]
            # Bright center dot at target
            draw_circle of [tp[0], tp[1], 3, 200, 220, 255]

    # Epic cells — large dark pulsing circles
    for i in range of (len of game.epic_cells):
        e is game.epic_cells[i]
        if e.active == 1:
            pos is world_to_screen of [e.px, e.py, cam_x, cam_y, screen_w, game_h, game.world_w, game.world_h]
            if pos[0] > -100 and pos[0] < screen_w + 100 and pos[1] > -100 and pos[1] < game_h + 100:
                px_r is floor of (e.radius * _cam_ppu)
                # Pulse effect
                pulse is (sin of (game.tick * 0.05)) * 3
                px_r is px_r + floor of pulse
                # Draw with creature body for visual richness
                draw_creature_body of [e.spec, pos[0], pos[1], e.angle, px_r, game.tick, 0]
                # Suction ring indicator
                ring_r is floor of (EPIC_SUCTION_RADIUS * _cam_ppu)
                # Draw faint ring at suction radius using points
                ring_segs is 24
                for rs in range of ring_segs:
                    ra is rs * 6.283 / ring_segs
                    rx is pos[0] + floor of ((cos of ra) * ring_r)
                    ry is pos[1] + floor of ((sin of ra) * ring_r)
                    draw_point of [rx, ry, 40, 20, 30]

    # Part drops — colored dots with pulsing glow
    for i in range of (len of game.part_drops):
        pd is game.part_drops[i]
        if pd.active == 1:
            pos is world_to_screen of [pd.px, pd.py, cam_x, cam_y, screen_w, game_h, game.world_w, game.world_h]
            if pos[0] > -10 and pos[0] < screen_w + 10 and pos[1] > -10 and pos[1] < game_h + 10:
                pulse is 3 + floor of ((sin of (game.tick * 0.1)) * 2)
                # Color by type
                if pd.part_type == 0:
                    # Mouth — red
                    draw_circle of [pos[0], pos[1], pulse, 255, 100, 80]
                elif pd.part_type == 1:
                    # Appendage — blue
                    draw_circle of [pos[0], pos[1], pulse, 80, 150, 255]
                else:
                    # Palette — yellow
                    draw_circle of [pos[0], pos[1], pulse, 255, 220, 80]
                # Inner white dot
                draw_circle of [pos[0], pos[1], 2, 255, 255, 255]

# ============================================================
# Process game events into particles
# ============================================================

define process_game_events(game) as:
    # Death burst
    if game.event_kill_x >= 0.0:
        spawn_death_burst of [game.event_kill_x, game.event_kill_y, game.event_kill_palette]
    # Collision flash
    if game.event_collision_x >= 0.0:
        spawn_collision_flash of [game.event_collision_x, game.event_collision_y]
    # Collection sparkle
    if game.event_collect_x >= 0.0:
        spawn_collection_sparkle of [game.event_collect_x, game.event_collect_y]
    # Wake trail from player movement
    speed_sq is game.vx * game.vx + game.vy * game.vy
    if speed_sq > 0.5 and game.tick % 3 == 0:
        spawn_wake of [game.px, game.py, game.angle]

# ============================================================
# Player — always at screen center, with full creature body.
# ============================================================

define draw_player(game, screen_w, game_h) as:
    p_sx is floor of (screen_w / 2)
    p_sy is floor of (game_h / 2)
    p_rad is creature_radius of [game.creature, game.mass]
    px_rad is clamp of [floor of (p_rad * _cam_ppu), 8, 40]
    draw_creature_body of [game.creature, p_sx, p_sy, game.angle, px_rad, game.tick, game.spikes_level]

# ============================================================
# Draw mate entity
# ============================================================

define draw_mate(game, cam_x, cam_y, screen_w, game_h) as:
    if game.mate_state < 2:
        return null
    dx is torus_delta of [cam_x, game.mate_px, game.world_w]
    dy is torus_delta of [cam_y, game.mate_py, game.world_h]
    sx is floor of (screen_w / 2 + dx * _cam_ppu)
    sy is floor of (game_h / 2 + dy * _cam_ppu)
    if sx > -40 and sx < screen_w + 40 and sy > -40 and sy < game_h + 40:
        # Use player's spec but with a different palette (+2 mod 5)
        mate_spec is game.creature
        mate_pal is (game.creature.palette + 2) % 5
        p_rad is creature_radius of [game.creature, game.mass]
        px_rad is clamp of [floor of (p_rad * _cam_ppu), 8, 40]
        # Draw mate with shifted palette
        orig_pal is mate_spec.palette
        mate_spec.palette is mate_pal
        draw_creature_body of [mate_spec, sx, sy, game.mate_angle, px_rad, game.tick, 0]
        mate_spec.palette is orig_pal
        # Heart indicator if arrived
        if game.mate_state == 3:
            pulse is (sin of (game.tick * 0.1)) * 2
            draw_circle of [sx, sy - px_rad - 8, floor of (3 + pulse), 255, 100, 150]

# ============================================================
# Tier transition visual effect
# ============================================================

define draw_tier_transition(game, screen_w, game_h) as:
    if game.tier_transition_timer <= 0:
        return null
    pcx is floor of (screen_w / 2)
    pcy is floor of (game_h / 2)
    t_progress is 1.0 - game.tier_transition_timer / 120.0
    fade is 1.0 - t_progress
    # Expanding pulse of light — translucent, so it reads as a soft shockwave
    # rather than a solid disc. (The old version computed an alpha but never
    # passed it, filling the screen opaque white.)
    rad is floor of (t_progress * 340.0)
    if rad > 4:
        draw_circle of [pcx, pcy, rad, 170, 215, 255, floor of (fade * 30)]
        draw_circle of [pcx, pcy, floor of (rad * 0.72), 205, 232, 255, floor of (fade * 22)]
    # "TIER N" banner near the top, fading, announcing the tier just reached
    # (scale_tier is already the new tier here — the old +1 was off by one).
    if game.tier_transition_timer > 60:
        tb is 150 + floor of (fade * 105)
        draw_text of [pcx - 48, 60, f"TIER {game.scale_tier}", 150, tb, 255, 3]

# ============================================================
# HUD — background, energy bar, text readouts.
# ============================================================

define draw_hud(game, screen_w, game_h) as:
    # Panel with a glowing cyan accent line along the top edge.
    draw_rect of [0, game_h, screen_w, HUD_HEIGHT, 11, 15, 25, 238]
    draw_rect of [0, game_h - 1, screen_w, 1, 90, 200, 220, 90]
    draw_rect of [0, game_h, screen_w, 2, 60, 150, 180, 120]

    # Energy bar: rounded track + color-by-level fill + a top sheen.
    tx is 12
    ty is game_h + 10
    tw is 200
    th is 12
    draw_rrect of [tx, ty, tw, th, 6, 26, 36, 50, 220]
    e_frac is clamp of [game.energy / 200.0, 0.0, 1.0]
    fw is floor of (tw * e_frac)
    er is 60
    eg is 220
    eb is 120
    if game.energy < 60:
        er is 240
        eg is 200
        eb is 70
    if game.energy < 30:
        er is 240
        eg is 75
        eb is 70
    if fw > 4:
        draw_rrect of [tx, ty, fw, th, 6, er, eg, eb, 235]
        draw_rrect of [tx, ty, fw, 4, 4, 255, 255, 255, 45]
    draw_text of [tx + 3, ty + th + 4, f"Energy {floor of game.energy}", 165, 195, 210, 1]

    # Stats — two rows, colour-coded.
    draw_text of [232, game_h + 7, f"Score {game.score}", 235, 240, 245, 2]
    draw_text of [232, game_h + 31, f"DNA {game.dna}", 110, 220, 255, 1]
    draw_text of [360, game_h + 7, f"Tier {game.scale_tier}", 255, 205, 90, 2]
    draw_text of [360, game_h + 31, f"Food {game.food_eaten}", 120, 230, 140, 1]
    draw_text of [475, game_h + 7, f"S{game.speed_level}  N{game.sense_level}  K{game.spikes_level}", 175, 190, 205, 1]
    draw_text of [475, game_h + 31, "1:Spd 2:Sns 3:Spk", 105, 118, 135, 1]

    # Evolve-ready prompt — a pulsing pill, since evolving is now a deliberate
    # action the player must choose when eligible.
    if game.evolve_ready == 1:
        pr is (sin of (game.tick * 0.15)) * 0.5 + 0.5
        draw_rrect of [612, game_h + 14, 178, 32, 9, 50, 185, 115, floor of (28 + pr * 55)]
        draw_rrect of [612, game_h + 14, 178, 32, 9, 120, 240, 170, floor of (40 + pr * 70)]
        tg is 205 + floor of (pr * 50)
        draw_text of [626, game_h + 24, "PRESS  E  TO  EVOLVE", 150, tg, 180, 1]

    # Transient message
    if (len of game.message) > 0:
        draw_text of [232, game_h + 47, game.message, 245, 240, 150, 1]

# ============================================================
# Main render function — orchestrates the frame.
# ============================================================

define render_game(game, screen_w, screen_h) as:
    game_h is screen_h - HUD_HEIGHT
    cam_x is game.px
    cam_y is game.py

    # Update camera zoom
    update_camera_zoom of game

    # Update particles
    process_game_events of game
    update_particles of null

    draw_clear of [BG_R, BG_G, BG_B]
    draw_ocean_depth of [screen_w, game_h]
    draw_caustics of [screen_w, game_h, game.tick]
    draw_water_current of [game, cam_x, cam_y, screen_w, game_h]
    draw_plankton of [screen_w, game_h, game.tick, game.current_angle]
    draw_entities of [game, cam_x, cam_y, screen_w, game_h]
    draw_combat_entities of [game, cam_x, cam_y, screen_w, game_h]
    draw_mate of [game, cam_x, cam_y, screen_w, game_h]
    draw_player of [game, screen_w, game_h]
    draw_particles of [cam_x, cam_y, screen_w, game_h, game.world_w, game.world_h]
    draw_tier_transition of [game, screen_w, game_h]
    draw_hud of [game, screen_w, game_h]

# Render the game world only (no HUD, no present) — used as backdrop
# for overlay screens (pause, game over, diet choice).
define render_world_only(game, screen_w, screen_h) as:
    game_h is screen_h - HUD_HEIGHT
    cam_x is game.px
    cam_y is game.py

    # Update camera zoom
    update_camera_zoom of game

    # Update particles
    process_game_events of game
    update_particles of null

    draw_clear of [BG_R, BG_G, BG_B]
    draw_ocean_depth of [screen_w, game_h]
    draw_caustics of [screen_w, game_h, game.tick]
    draw_water_current of [game, cam_x, cam_y, screen_w, game_h]
    draw_plankton of [screen_w, game_h, game.tick, game.current_angle]
    draw_entities of [game, cam_x, cam_y, screen_w, game_h]
    draw_combat_entities of [game, cam_x, cam_y, screen_w, game_h]
    draw_mate of [game, cam_x, cam_y, screen_w, game_h]
    draw_player of [game, screen_w, game_h]
    draw_particles of [cam_x, cam_y, screen_w, game_h, game.world_w, game.world_h]
    draw_tier_transition of [game, screen_w, game_h]

# Render a static ocean background (animated water lines on dark bg)
define render_ocean_bg(screen_w, screen_h, tick) as:
    draw_clear of [BG_R, BG_G, BG_B]
    # Animate some faint water current lines across the screen
    for i in range of 20:
        x0 is floor of (i * 42)
        y0 is floor of (200 + (sin of (i * 0.5 + tick * 0.008)) * 80)
        x1 is x0 + 30
        y1 is y0 + floor of ((cos of (i * 0.3 + tick * 0.006)) * 10)
        draw_line of [x0, y0, x1, y1, 15, 28, 45]
    for i in range of 15:
        x0 is floor of (i * 55 + 20)
        y0 is floor of (350 + (cos of (i * 0.7 + tick * 0.005)) * 60)
        x1 is x0 + 25
        y1 is y0 + floor of ((sin of (i * 0.4 + tick * 0.007)) * 8)
        draw_line of [x0, y0, x1, y1, 12, 24, 40]
