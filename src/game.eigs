# ============================================================
# Tidepool — Game State & Core Loop
# ============================================================
# The main game state and simulation tick.

load_file of "src/constants.eigs"
load_file of "src/math_utils.eigs"
load_file of "src/entities.eigs"

# ============================================================
# Game state constructor
# ============================================================

define new_game(world_w, world_h, seed_val) as:
    seed_random of seed_val

    game is {
        "world_w": world_w,
        "world_h": world_h,

        # Player physics
        "px": world_w / 2.0,
        "py": world_h / 2.0,
        "vx": 0.0, "vy": 0.0,
        "angle": 0.0,
        "thrusting": 0,
        "braking": 0,
        "turning": 0,

        # Player stats
        "mass": 1,
        "energy": 100,
        "score": 0,
        "dna": 0,
        "food_eaten": 0,
        "speed_level": 0,
        "sense_level": 0,
        "spikes_level": 0,

        # Timing
        "tick": 0,
        "energy_timer": 0.0,

        # State
        "game_over": 0,
        "game_over_reason": GAME_OVER_NONE,
        "message": "",

        # Diet
        "alignment": 0,
        "plants_eaten": 0,
        "meat_eaten": 0,

        # Part unlock bitmasks
        "unlocked_mouths": 7,
        "unlocked_appendages": 1,
        "unlocked_palettes": 1,
        "unlocked_weapons": 0,

        # Scale tier
        "scale_tier": 0,
        "tier_transition_timer": 0,

        # Mating system
        "mate_state": 0,
        "mate_px": 0.0, "mate_py": 0.0,
        "mate_vx": 0.0, "mate_vy": 0.0,
        "mate_angle": 0.0,
        "mate_timer": 0,

        # Water current
        "current_angle": 0.0,

        # Combat cooldowns
        "poison_cooldown": 0,
        "electric_cooldown": 0,
        "jet_cooldown": 0,
        "jet_active": 0,
        # Brief invulnerability after taking a bite (i-frames) so a losing
        # collision costs energy + knockback instead of being an instant kill.
        "invuln_timer": 0,

        # Creature
        "creature": new_creature_spec of null,

        # Per-frame events (consumed by renderer and audio, cleared next frame)
        "event_kill_x": 0.0, "event_kill_y": 0.0,
        "event_kill_palette": 0,
        "event_collision_x": -1.0, "event_collision_y": -1.0,
        "event_collect_x": -1.0, "event_collect_y": -1.0,
        # Boolean audio events
        "event_ate_plant": 0, "event_ate_meat": 0,
        "event_killed": 0, "event_died": 0,
        "event_mate_call": 0, "event_part_collect": 0,
        "event_tier_up": 0, "event_poison": 0,
        "event_electric": 0, "event_jet": 0,
        "event_player_hurt": 0,

        # Entity lists
        "food": [],
        "predators": [],
        "meat": [],
        "species": [],
        "epic_cells": [],
        "poison_clouds": [],
        "electric_bolts": [],
        "part_drops": []
    }

    # Spawn initial food
    for i in range of MAX_FOOD:
        x is rand_range_f of [0, world_w]
        y is rand_range_f of [0, world_h]
        append of [game.food, new_food of [x, y]]

    # Spawn initial species with varied diets
    # Species 0 is always small passive herbivore prey
    append of [game.species, new_species of [MOUTH_FILTER, 0, 1]]
    for i in range of 3:
        roll is random_int of [0, 9]
        if roll < 4:
            diet is MOUTH_FILTER
            aggro is random_int of [0, 1]
        elif roll < 8:
            diet is MOUTH_JAW
            aggro is random_int of [2, 3]
        else:
            diet is MOUTH_PROBOSCIS
            aggro is random_int of [1, 2]
        size is random_int of [1, 3]
        append of [game.species, new_species of [diet, aggro, size]]

    # Spawn initial predators with species-derived specs
    for i in range of 8:
        x is rand_range_f of [0, world_w]
        y is rand_range_f of [0, world_h]
        angle is rand_range_f of [0, 2.0 * PI]
        sp_id is random_int of [0, 3]
        size is game.species[sp_id].base_size
        pred is new_predator of [x, y, angle, sp_id, size]
        # Copy species spec and adjust segments to predator size
        pred.spec is random_creature_spec of [0, game.species[sp_id].diet]
        pred.spec.palette is game.species[sp_id].spec.palette
        pred.spec.body_shape is game.species[sp_id].spec.body_shape
        pred.spec.body_segments is clamp of [size, 1, CREATURE_MAX_SEGMENTS]
        pred.spec.mouth_type is game.species[sp_id].diet
        append of [game.predators, pred]

    # Pre-allocate meat pool so spawn_meat can reuse slots
    for i in range of MAX_MEAT:
        m is new_meat of [0.0, 0.0, 0]
        m.active is 0
        append of [game.meat, m]

    return game

# ============================================================
# Player physics
# ============================================================

define player_radius(game) as:
    return creature_radius of [game.creature, game.mass]

define player_thrust(game) as:
    thrust is creature_thrust of [game.creature, game.speed_level, game.scale_tier, game.mass]
    if game.jet_active > 0:
        return thrust * 2.5
    return thrust

define player_drag(game) as:
    return creature_drag of game.creature

define player_turn_rate(game) as:
    return creature_turn_rate of [game.creature, game.mass]

# ============================================================
# Mating system
# ============================================================

define mate_dna_threshold(game) as:
    return 3 + game.scale_tier * 2

define call_mate(game) as:
    threshold is mate_dna_threshold of game
    if game.mate_state != 0:
        return null
    if game.dna < threshold:
        game.message is f"Need {threshold} DNA to call a mate."
        return null
    # Spawn mate 15-20 units away
    spawn_dist is 15.0 + (random of null) * 5.0
    angle is rand_range_f of [0 - PI, PI]
    game.mate_px is wrap_coord of [game.px + (cos of angle) * spawn_dist, game.world_w]
    game.mate_py is wrap_coord of [game.py + (sin of angle) * spawn_dist, game.world_h]
    game.mate_vx is 0.0
    game.mate_vy is 0.0
    game.mate_angle is 0.0
    game.mate_state is 2
    game.mate_timer is 0
    game.event_mate_call is 1
    game.message is "Calling a mate..."

define update_mate(game) as:
    if game.mate_state < 2:
        return null

    dx is torus_delta of [game.mate_px, game.px, game.world_w]
    dy is torus_delta of [game.mate_py, game.py, game.world_h]
    dist is sqrt of (dx * dx + dy * dy)

    if dist < 1.5:
        game.mate_state is 3
        game.message is "Mate arrived! Press E to evolve."
        return null

    # Steer mate toward player
    target_angle is atan2 of [dy, dx]
    diff is angle_diff of [game.mate_angle, target_angle]
    max_turn is 4.0 * SIM_DT
    if diff > max_turn:
        diff is max_turn
    elif diff < (0 - max_turn):
        diff is 0 - max_turn
    game.mate_angle is normalize_angle of (game.mate_angle + diff)

    thrust is 10.0
    drag is 3.0
    cvx is (cos of game.current_angle) * CURRENT_SPEED
    cvy is (sin of game.current_angle) * CURRENT_SPEED
    game.mate_vx is game.mate_vx + (cos of game.mate_angle) * thrust * SIM_DT - game.mate_vx * drag * SIM_DT + cvx * SIM_DT
    game.mate_vy is game.mate_vy + (sin of game.mate_angle) * thrust * SIM_DT - game.mate_vy * drag * SIM_DT + cvy * SIM_DT
    speed is sqrt of (game.mate_vx * game.mate_vx + game.mate_vy * game.mate_vy)
    if speed > 6.0:
        game.mate_vx is game.mate_vx * 6.0 / speed
        game.mate_vy is game.mate_vy * 6.0 / speed
    game.mate_px is wrap_coord of [game.mate_px + game.mate_vx * SIM_DT, game.world_w]
    game.mate_py is wrap_coord of [game.mate_py + game.mate_vy * SIM_DT, game.world_h]

define evolve_tier_up(game) as:
    if game.mate_state != 3:
        return null
    threshold is mate_dna_threshold of game
    if game.dna < threshold:
        game.message is f"Need {threshold} DNA to evolve."
        return null
    game.dna is game.dna - threshold
    game.mate_state is 0

    # Tier up
    if game.scale_tier < SCALE_TIER_COUNT - 1:
        game.scale_tier is game.scale_tier + 1
        game.event_tier_up is 1
    game.tier_transition_timer is 120
    game.message is "A new world unfolds around you..."

    # Respawn all predators with new species from fresh species pool
    game.species is []
    append of [game.species, new_species of [MOUTH_FILTER, 0, 1]]
    for i in range of 3:
        roll is random_int of [0, 9]
        if roll < 4:
            diet is MOUTH_FILTER
            aggro is random_int of [0, 1]
        elif roll < 8:
            diet is MOUTH_JAW
            aggro is random_int of [2, 3]
        else:
            diet is MOUTH_PROBOSCIS
            aggro is random_int of [1, 2]
        size is random_int of [1, 3]
        append of [game.species, new_species of [diet, aggro, size]]

    # Respawn predators
    for i in range of (len of game.predators):
        pred is game.predators[i]
        pred.px is rand_range_f of [0, game.world_w]
        pred.py is rand_range_f of [0, game.world_h]
        pred.angle is rand_range_f of [0, 2.0 * PI]
        sp_id is random_int of [0, 3]
        pred.species_id is sp_id
        pred.size is game.species[sp_id].base_size
        pred.hp is pred.size + 1
        pred.radius is 0.5 + pred.size * 0.3
        pred.vx is 0.0
        pred.vy is 0.0
        pred.active is 1
        pred.stunned_timer is 0
        pred.spec is random_creature_spec of [game.scale_tier, game.species[sp_id].diet]
        pred.spec.palette is game.species[sp_id].spec.palette
        pred.spec.body_shape is game.species[sp_id].spec.body_shape
        pred.spec.body_segments is clamp of [pred.size, 1, CREATURE_MAX_SEGMENTS]
        pred.spec.mouth_type is game.species[sp_id].diet

    # Spawn epic cells at higher tiers
    if game.scale_tier >= 2 and (len of game.epic_cells) < 1:
        cx is rand_range_f of [0, game.world_w]
        cy is rand_range_f of [0, game.world_h]
        epic is new_epic_cell of [cx, cy, EPIC_PATROL_RADIUS]
        epic.spec.palette is random_int of [0, 4]
        epic.spec.body_segments is 5
        epic.spec.body_shape is SHAPE_SHELL
        append of [game.epic_cells, epic]

# ============================================================
# Core simulation tick
# ============================================================
# Mutates `game` in place. Returns `game` for convenience; callers
# can discard the return value.

define game_tick(game) as:
    if game.game_over == 1:
        return game

    clear_events of game
    game.tick is game.tick + 1

    # Physics — no observation needed, pure numeric mutation
    unobserved:
        # Water current rotation
        game.current_angle is game.current_angle + CURRENT_ROTATE_RATE * SIM_DT

        # Player turning
        if game.turning != 0:
            turn is player_turn_rate of game
            game.angle is game.angle + game.turning * turn * SIM_DT
            game.angle is normalize_angle of game.angle

        # Player thrust
        if game.thrusting == 1:
            thrust is player_thrust of game
            game.vx is game.vx + (cos of game.angle) * thrust * SIM_DT
            game.vy is game.vy + (sin of game.angle) * thrust * SIM_DT

        # Braking
        if game.braking == 1:
            game.vx is game.vx * 0.9
            game.vy is game.vy * 0.9

        # Water current force
        cx is (cos of game.current_angle) * CURRENT_SPEED * SIM_DT
        cy is (sin of game.current_angle) * CURRENT_SPEED * SIM_DT
        game.vx is game.vx + cx
        game.vy is game.vy + cy

        # Drag
        drag is player_drag of game
        game.vx is game.vx * (1.0 - drag * SIM_DT)
        game.vy is game.vy * (1.0 - drag * SIM_DT)

        # Move player
        game.px is wrap_coord of [game.px + game.vx * SIM_DT, game.world_w]
        game.py is wrap_coord of [game.py + game.vy * SIM_DT, game.world_h]

        # Energy drain
        game.energy_timer is game.energy_timer + SIM_DT
    if game.energy_timer >= 1.0:
        game.energy_timer is game.energy_timer - 1.0
        game.energy is game.energy - 1
        if game.energy <= 0:
            game.game_over is 1
            game.game_over_reason is GAME_OVER_STARVED
            game.event_died is 1
            game.message is "Starved to death"
            return game

    # Food collision — torus_dist_sq inlined, hoisted world constants
    p_radius is player_radius of game
    eat_range is (p_radius + FOOD_RADIUS) * (p_radius + FOOD_RADIUS)
    gpx is game.px
    gpy is game.py
    ww is game.world_w
    wh is game.world_h
    hw is ww * 0.5
    hh is wh * 0.5
    food_n is len of game.food
    pred_n is len of game.predators
    meat_n is len of game.meat
    for i in range of food_n:
        f is game.food[i]
        if f.active == 1:
            dx is f.px - gpx
            if dx > hw:
                dx is dx - ww
            elif dx < (0 - hw):
                dx is dx + ww
            dy is f.py - gpy
            if dy > hh:
                dy is dy - wh
            elif dy < (0 - hh):
                dy is dy + wh
            if dx * dx + dy * dy < eat_range:
                f.active is 0
                game.energy is game.energy + 10
                game.score is game.score + 1
                game.food_eaten is game.food_eaten + 1
                game.plants_eaten is game.plants_eaten + 1
                game.dna is game.dna + 1
                game.event_ate_plant is 1
                # Respawn food elsewhere
                f.px is rand_range_f of [0, ww]
                f.py is rand_range_f of [0, wh]
                f.active is 1

    # Predator AI and physics
    player_power is creature_collision_power of [game.creature, game.spikes_level, game.mass]
    for i in range of pred_n:
        pred is game.predators[i]
        if pred.active == 1:
            # Stun timer
            if pred.stunned_timer > 0:
                pred.stunned_timer is pred.stunned_timer - 1

            # Diet-driven AI + boid flocking — unobserved for performance
            unobserved:
                if pred.stunned_timer <= 0:
                    sp is game.species[pred.species_id]
                    sp_diet is sp.diet
                    sp_aggro is sp.aggression
                    flee_from_player is 0
                    if player_power >= pred.size + 3:
                        flee_from_player is 1

                    # Size-dependent physics
                    pred_thrust is max of [PREDATOR_BASE_THRUST - pred.size * 1.0, 3.0]
                    pred_turn is max of [PREDATOR_BASE_TURN_RATE - pred.size * 0.3, 1.5]
                    pred_max_spd is max of [5.0 - pred.size * 0.5, 2.0]
                    chase_range is 5.0 + pred.size * 2.0
                    flee_range is 10.0

                    # Distance to player — torus_delta inlined
                    pdx is gpx - pred.px
                    if pdx > hw:
                        pdx is pdx - ww
                    elif pdx < (0 - hw):
                        pdx is pdx + ww
                    pdy is gpy - pred.py
                    if pdy > hh:
                        pdy is pdy - wh
                    elif pdy < (0 - hh):
                        pdy is pdy + wh
                    player_dist is sqrt of (pdx * pdx + pdy * pdy)

                    # Wander timer: only re-evaluate targets periodically
                    pred.wander_timer is pred.wander_timer - 1
                    needs_retarget is pred.wander_timer <= 0
                    if needs_retarget == 1:
                        pred.target_angle is rand_range_f of [0 - PI, PI]
                        pred.wander_timer is random_int of [30, 90]

                    # Reactive behaviors run every tick (cheap: single distance check)
                    # Flee overrides target angle immediately
                    if sp_diet == MOUTH_FILTER:
                        if flee_from_player == 0 and player_dist < flee_range:
                            pred.target_angle is atan2 of [0 - pdy, 0 - pdx]
                    elif sp_diet == MOUTH_JAW or sp_diet == MOUTH_PROBOSCIS:
                        if sp_aggro >= 2 and flee_from_player == 0 and player_dist < chase_range:
                            pred.target_angle is atan2 of [pdy, pdx]
                        elif flee_from_player == 1 and player_dist < flee_range:
                            pred.target_angle is atan2 of [0 - pdy, 0 - pdx]

                    # Expensive searches only on retarget (food seek, NPC hunt, flocking)
                    if needs_retarget == 1:
                        if sp_diet == MOUTH_FILTER or sp_diet == MOUTH_PROBOSCIS:
                            # Seek nearest food (batch C builtin)
                            nf is nearest_in_range of [game.food, pred.px, pred.py, 8.0, ww, wh]
                            if nf != null:
                                pred.target_angle is atan2 of [nf.dy, nf.dx]

                        if sp_diet == MOUTH_JAW or sp_diet == MOUTH_PROBOSCIS:
                            # Hunt smaller NPCs of different species
                            best_prey_dsq is chase_range * chase_range
                            best_prey_angle is pred.target_angle
                            found_prey is 0
                            for pi in range of pred_n:
                                if pi == i:
                                    continue
                                prey is game.predators[pi]
                                if prey.active != 1 or prey.species_id == pred.species_id:
                                    continue
                                if prey.size >= pred.size:
                                    continue
                                prx is torus_delta of [pred.px, prey.px, ww]
                                pry is torus_delta of [pred.py, prey.py, wh]
                                pr_dsq is prx * prx + pry * pry
                                if pr_dsq < best_prey_dsq:
                                    best_prey_dsq is pr_dsq
                                    best_prey_angle is atan2 of [pry, prx]
                                    found_prey is 1
                            if found_prey == 1:
                                pred.target_angle is best_prey_angle

                        # Boid flocking: align/cohere/separate with same-species
                        align_x is 0.0
                        align_y is 0.0
                        cohere_x is 0.0
                        cohere_y is 0.0
                        sep_x is 0.0
                        sep_y is 0.0
                        flock_count is 0
                        for j in range of pred_n:
                            if j == i:
                                continue
                            other is game.predators[j]
                            if other.active != 1 or other.species_id != pred.species_id:
                                continue
                            odx is torus_delta of [pred.px, other.px, ww]
                            ody is torus_delta of [pred.py, other.py, wh]
                            od_sq is odx * odx + ody * ody
                            if od_sq > 36.0:
                                continue
                            od is sqrt of od_sq
                            flock_count is flock_count + 1
                            align_x is align_x + cos of other.angle
                            align_y is align_y + sin of other.angle
                            cohere_x is cohere_x + odx
                            cohere_y is cohere_y + ody
                            if od < 1.5 and od > 0.01:
                                sep_x is sep_x - odx / od
                                sep_y is sep_y - ody / od

                        if flock_count > 0:
                            flock_dx is align_x * 0.3 + cohere_x * 0.2 + sep_x * 0.5
                            flock_dy is align_y * 0.3 + cohere_y * 0.2 + sep_y * 0.5
                            flock_mag is sqrt of (flock_dx * flock_dx + flock_dy * flock_dy)
                            if flock_mag > 0.01:
                                flock_angle is atan2 of [flock_dy, flock_dx]
                                blend_dx is (cos of pred.target_angle) * 0.7 + (cos of flock_angle) * 0.3
                                blend_dy is (sin of pred.target_angle) * 0.7 + (sin of flock_angle) * 0.3
                                pred.target_angle is atan2 of [blend_dy, blend_dx]

                    # Steer toward target angle
                    diff is angle_diff of [pred.angle, pred.target_angle]
                    steer is clamp of [diff, 0 - pred_turn * SIM_DT, pred_turn * SIM_DT]
                    pred.angle is normalize_angle of (pred.angle + steer)

                    # Thrust with speed cap
                    pred.vx is pred.vx + (cos of pred.angle) * pred_thrust * SIM_DT
                    pred.vy is pred.vy + (sin of pred.angle) * pred_thrust * SIM_DT
                    spd is sqrt of (pred.vx * pred.vx + pred.vy * pred.vy)
                    if spd > pred_max_spd:
                        pred.vx is pred.vx * (pred_max_spd / spd)
                        pred.vy is pred.vy * (pred_max_spd / spd)

                # Drag (always applies)
                pred.vx is pred.vx * (1.0 - PREDATOR_BASE_DRAG * SIM_DT)
                pred.vy is pred.vy * (1.0 - PREDATOR_BASE_DRAG * SIM_DT)

                # Move
                pred.px is wrap_coord of [pred.px + pred.vx * SIM_DT, ww]
                pred.py is wrap_coord of [pred.py + pred.vy * SIM_DT, wh]

            # Herbivore predators eat food on contact — torus_dist_sq inlined,
            # hoisted world constants + pred position + eat range squared.
            if game.species[pred.species_id].diet == MOUTH_FILTER:
                ppx is pred.px
                ppy is pred.py
                pred_eat_sq is (pred.radius + FOOD_RADIUS) * (pred.radius + FOOD_RADIUS)
                for fi in range of food_n:
                    fd is game.food[fi]
                    if fd.active == 1:
                        dx is fd.px - ppx
                        if dx > hw:
                            dx is dx - ww
                        elif dx < (0 - hw):
                            dx is dx + ww
                        dy is fd.py - ppy
                        if dy > hh:
                            dy is dy - wh
                        elif dy < (0 - hh):
                            dy is dy + wh
                        if dx * dx + dy * dy < pred_eat_sq:
                            fd.px is rand_range_f of [0, ww]
                            fd.py is rand_range_f of [0, wh]

            # Predator-player collision — torus_dist_sq inlined
            cpp_dx is pred.px - gpx
            if cpp_dx > hw:
                cpp_dx is cpp_dx - ww
            elif cpp_dx < (0 - hw):
                cpp_dx is cpp_dx + ww
            cpp_dy is pred.py - gpy
            if cpp_dy > hh:
                cpp_dy is cpp_dy - wh
            elif cpp_dy < (0 - hh):
                cpp_dy is cpp_dy + wh
            dist_sq is cpp_dx * cpp_dx + cpp_dy * cpp_dy
            kill_range is (p_radius + pred.radius) * (p_radius + pred.radius)
            if dist_sq < kill_range:
                # Zone-aware combat: determine which zone of each combatant is engaged
                cdx is torus_delta of [gpx, pred.px, ww]
                cdy is torus_delta of [gpy, pred.py, wh]
                player_zone is body_zone_from_delta of [game.angle, cdx, cdy]
                pred_zone is body_zone_from_delta of [pred.angle, 0 - cdx, 0 - cdy]
                zone_player_power is creature_collision_power_for_zone of [game.creature, game.spikes_level, game.mass, player_zone]
                pred_power is predator_collision_power_for_zone of [pred, pred_zone]
                if zone_player_power >= pred_power:
                    # Player overpowers — damage predator, knockback
                    dmg is 1 + floor of ((zone_player_power - pred_power) / 2)
                    pred.hp is pred.hp - dmg
                    # Knockback
                    bdx is torus_delta of [gpx, pred.px, ww]
                    bdy is torus_delta of [gpy, pred.py, wh]
                    bd is sqrt of (bdx * bdx + bdy * bdy)
                    if bd > 0.01:
                        pred.vx is pred.vx + (bdx / bd) * 2.0
                        pred.vy is pred.vy + (bdy / bd) * 2.0
                        game.vx is game.vx - (bdx / bd) * 1.0
                        game.vy is game.vy - (bdy / bd) * 1.0
                    game.event_collision_x is pred.px
                    game.event_collision_y is pred.py
                    if pred.hp <= 0:
                        pred.active is 0
                        game.score is game.score + 10 + pred.size * 3
                        game.dna is game.dna + 3
                        game.event_kill_x is pred.px
                        game.event_kill_y is pred.py
                        game.event_kill_palette is pred.spec.palette
                        game.event_killed is 1
                        # Drop meat into the pre-allocated pool
                        spawn_meat of [game.meat, pred.px, pred.py, 300]
                        # Part drop chance
                        try_drop_part of [game, pred]
                else:
                    # Player is out-powered in the engaged zone. Take a bite
                    # (energy damage scaled by the power gap) plus knockback,
                    # not an instant kill. Recent-hit invulnerability prevents
                    # a predator from chewing through all your energy in a few
                    # adjacent ticks. Death only when energy runs out.
                    if game.invuln_timer <= 0:
                        gap is pred_power - zone_player_power
                        bite is 20 + gap * 8
                        if bite > 60:
                            bite is 60
                        game.energy is game.energy - bite
                        game.invuln_timer is 45
                        game.event_player_hurt is 1
                        game.event_collision_x is pred.px
                        game.event_collision_y is pred.py
                        # Knock the player away from the predator (and nudge the
                        # predator forward), mirroring the overpower branch.
                        bdx is torus_delta of [gpx, pred.px, ww]
                        bdy is torus_delta of [gpy, pred.py, wh]
                        bd is sqrt of (bdx * bdx + bdy * bdy)
                        if bd > 0.01:
                            game.vx is game.vx - (bdx / bd) * 3.0
                            game.vy is game.vy - (bdy / bd) * 3.0
                            pred.vx is pred.vx + (bdx / bd) * 1.0
                            pred.vy is pred.vy + (bdy / bd) * 1.0
                        if game.energy <= 0:
                            game.energy is 0
                            game.game_over is 1
                            game.event_died is 1
                            game.game_over_reason is GAME_OVER_CONSUMED
                            game.message is "Consumed by predator"
                            return game

    # NPC-vs-NPC combat
    npc_combat of game

    # Meat collection (carnivore/omnivore)
    for i in range of meat_n:
        m is game.meat[i]
        if m.active == 1:
            m.lifetime is m.lifetime - 1
            if m.lifetime <= 0:
                m.active is 0
            else:
                # Meat-player collision — torus_dist_sq inlined
                mp_dx is m.px - gpx
                if mp_dx > hw:
                    mp_dx is mp_dx - ww
                elif mp_dx < (0 - hw):
                    mp_dx is mp_dx + ww
                mp_dy is m.py - gpy
                if mp_dy > hh:
                    mp_dy is mp_dy - wh
                elif mp_dy < (0 - hh):
                    mp_dy is mp_dy + wh
                dist_sq is mp_dx * mp_dx + mp_dy * mp_dy
                eat_range is (p_radius + 0.4) * (p_radius + 0.4)
                if dist_sq < eat_range:
                    m.active is 0
                    game.energy is game.energy + 15
                    game.score is game.score + 5
                    game.food_eaten is game.food_eaten + 1
                    game.meat_eaten is game.meat_eaten + 1
                    game.dna is game.dna + 2
                    game.event_ate_meat is 1
                    game.event_collect_x is m.px
                    game.event_collect_y is m.py

    # Part drop collection and decay
    update_part_drops of game

    # Auto weapons (poison, electric)
    player_auto_weapons of game

    # Poison cloud update (expand, damage, drift, despawn)
    update_poison_clouds of game

    # Electric bolt decay
    for i in range of (len of game.electric_bolts):
        eb is game.electric_bolts[i]
        if eb.active == 1:
            eb.lifetime is eb.lifetime - 1
            if eb.lifetime <= 0:
                eb.active is 0

    # Combat cooldowns
    if game.poison_cooldown > 0:
        game.poison_cooldown is game.poison_cooldown - 1
    if game.electric_cooldown > 0:
        game.electric_cooldown is game.electric_cooldown - 1
    if game.jet_cooldown > 0:
        game.jet_cooldown is game.jet_cooldown - 1
    if game.jet_active > 0:
        game.jet_active is game.jet_active - 1
    if game.invuln_timer > 0:
        game.invuln_timer is game.invuln_timer - 1

    # Epic cells (patrol, suction, collision)
    update_epic_cells of game
    if game.game_over == 1:
        return game

    # Scale tier progression — one tier per 10 food eaten
    if game.scale_tier < SCALE_TIER_COUNT - 1:
        if game.food_eaten >= (game.scale_tier + 1) * 10:
            game.scale_tier is game.scale_tier + 1
            game.event_tier_up is 1
            game.message is ""

    # Update mate approach
    update_mate of game

    # Tier transition countdown
    if game.tier_transition_timer > 0:
        game.tier_transition_timer is game.tier_transition_timer - 1

    return game

# ============================================================
# NPC-vs-NPC combat
# ============================================================

define npc_combat(game) as:
    num_preds is len of game.predators
    ww is game.world_w
    wh is game.world_h
    species is game.species
    species_n is len of species
    for i in range of num_preds:
        attacker is game.predators[i]
        if attacker.active != 1:
            continue
        if attacker.stunned_timer > 0:
            continue
        if attacker.species_id < 0 or attacker.species_id >= species_n:
            continue
        a_diet is species[attacker.species_id].diet
        if a_diet == MOUTH_FILTER:
            continue
        a_px is attacker.px
        a_py is attacker.py
        a_size is attacker.size
        a_radius is attacker.radius
        a_species_id is attacker.species_id
        for j in range of num_preds:
            if i == j:
                continue
            target is game.predators[j]
            if target.active != 1:
                continue
            if target.species_id == a_species_id:
                continue
            if target.species_id < 0 or target.species_id >= species_n:
                continue
            t_diet is species[target.species_id].diet
            # Only attack herbivores or smaller NPCs
            if t_diet != MOUTH_FILTER and target.size >= a_size:
                continue
            dist_sq is torus_dist_sq of [a_px, a_py, target.px, target.py, ww, wh]
            contact is (a_radius + target.radius) * (a_radius + target.radius)
            if dist_sq < contact:
                target.hp is target.hp - 1
                # Knockback
                bdx is torus_delta of [a_px, target.px, ww]
                bdy is torus_delta of [a_py, target.py, wh]
                bd is sqrt of (bdx * bdx + bdy * bdy)
                if bd > 0.01:
                    target.vx is target.vx + (bdx / bd) * 2.0
                    target.vy is target.vy + (bdy / bd) * 2.0
                if target.hp <= 0:
                    game.event_kill_x is target.px
                    game.event_kill_y is target.py
                    game.event_kill_palette is target.spec.palette
                    game.event_killed is 1
                    spawn_meat of [game.meat, target.px, target.py, 300]
                    # Respawn predator
                    target.px is rand_range_f of [0, ww]
                    target.py is rand_range_f of [0, wh]
                    target.hp is target.size + 1
                    target.angle is rand_range_f of [0, 2.0 * PI]
                    target.vx is 0.0
                    target.vy is 0.0

# ============================================================
# Auto weapons (poison cloud, electric bolt)
# ============================================================

define player_auto_weapons(game) as:
    poison_count is count_appendage_type of [game.creature, APPENDAGE_POISON]
    electric_count is count_appendage_type of [game.creature, APPENDAGE_ELECTRIC]
    num_preds is len of game.predators
    ww is game.world_w
    wh is game.world_h
    gpx is game.px
    gpy is game.py

    # Auto-poison: trigger when enemy within 3 units
    if poison_count > 0 and game.poison_cooldown == 0:
        for i in range of num_preds:
            p is game.predators[i]
            if p.active != 1:
                continue
            dist is torus_dist of [gpx, gpy, p.px, p.py, ww, wh]
            if dist < 3.0:
                append of [game.poison_clouds, new_poison_cloud of [gpx, gpy, 1]]
                game.poison_cooldown is POISON_COOLDOWN_MAX
                break

    # Auto-electric: fire at nearest target within range
    if electric_count > 0 and game.electric_cooldown == 0:
        best_dist is 999.0
        best_idx is -1
        for i in range of num_preds:
            p is game.predators[i]
            if p.active != 1 or p.stunned_timer > 0:
                continue
            dist is torus_dist of [gpx, gpy, p.px, p.py, ww, wh]
            if dist < ELECTRIC_RANGE and dist < best_dist:
                best_dist is dist
                best_idx is i
        if best_idx >= 0:
            target is game.predators[best_idx]
            append of [game.electric_bolts, new_electric_bolt of [gpx, gpy, target.px, target.py]]
            target.stunned_timer is ELECTRIC_STUN_DURATION
            target.hp is target.hp - 1
            if target.hp <= 0:
                game.event_kill_x is target.px
                game.event_kill_y is target.py
                game.event_kill_palette is target.spec.palette
                game.event_killed is 1
                game.score is game.score + 10 + target.size * 3
                spawn_meat of [game.meat, target.px, target.py, 300]
                try_drop_part of [game, target]
                target.px is rand_range_f of [0, ww]
                target.py is rand_range_f of [0, wh]
                target.hp is target.size + 1
                target.angle is rand_range_f of [0, 2.0 * PI]
                target.vx is 0.0
                target.vy is 0.0
            game.electric_cooldown is ELECTRIC_COOLDOWN_MAX
            game.event_electric is 1

# ============================================================
# Poison cloud update
# ============================================================

define update_poison_clouds(game) as:
    alive is []
    ww is game.world_w
    wh is game.world_h
    gpx is game.px
    gpy is game.py
    cur_a is game.current_angle
    pred_n is len of game.predators
    cloud_n is len of game.poison_clouds
    for i in range of cloud_n:
        pc is game.poison_clouds[i]
        if pc.active != 1:
            continue
        pc.lifetime is pc.lifetime - 1
        if pc.lifetime <= 0:
            pc.active is 0
            continue
        # Expand radius
        pc.radius is 0.5 + 2.5 * (1.0 - pc.lifetime / POISON_DURATION)
        # Drift with current
        pc.px is wrap_coord of [pc.px + (cos of cur_a) * CURRENT_SPEED * SIM_DT, ww]
        pc.py is wrap_coord of [pc.py + (sin of cur_a) * CURRENT_SPEED * SIM_DT, wh]
        # Damage predators every 30 ticks
        if pc.owner_is_player == 1 and pc.lifetime % POISON_DAMAGE_INTERVAL == 0:
            for j in range of pred_n:
                pred is game.predators[j]
                if pred.active != 1:
                    continue
                dist_sq is torus_dist_sq of [pc.px, pc.py, pred.px, pred.py, ww, wh]
                if dist_sq < pc.radius * pc.radius:
                    pred.hp is pred.hp - 1
                    if pred.hp <= 0:
                        game.event_kill_x is pred.px
                        game.event_kill_y is pred.py
                        game.event_kill_palette is pred.spec.palette
                        game.event_killed is 1
                        game.score is game.score + 10 + pred.size * 3
                        spawn_meat of [game.meat, pred.px, pred.py, 300]
                        try_drop_part of [game, pred]
                        pred.px is rand_range_f of [0, ww]
                        pred.py is rand_range_f of [0, wh]
                        pred.hp is pred.size + 1
                        pred.angle is rand_range_f of [0, 2.0 * PI]
                        pred.vx is 0.0
                        pred.vy is 0.0
        # NPC clouds damage player
        if pc.owner_is_player == 0:
            dist_sq is torus_dist_sq of [pc.px, pc.py, gpx, gpy, ww, wh]
            if dist_sq < pc.radius * pc.radius and pc.lifetime % POISON_DAMAGE_INTERVAL == 0:
                game.energy is game.energy - 10
        append of [alive, pc]
    game.poison_clouds is alive

# ============================================================
# Epic cell update
# ============================================================

define update_epic_cells(game) as:
    ww is game.world_w
    wh is game.world_h
    gpx is game.px
    gpy is game.py
    # Spawn epics based on tier
    if game.scale_tier >= 2 and (len of game.epic_cells) < 1:
        cx is rand_range_f of [0, ww]
        cy is rand_range_f of [0, wh]
        epic is new_epic_cell of [cx, cy, EPIC_PATROL_RADIUS]
        epic.spec.palette is random_int of [0, 4]
        epic.spec.body_segments is 5
        epic.spec.body_shape is SHAPE_SHELL
        append of [game.epic_cells, epic]
    if game.scale_tier >= 4 and (len of game.epic_cells) < 2:
        cx is rand_range_f of [0, ww]
        cy is rand_range_f of [0, wh]
        epic is new_epic_cell of [cx, cy, EPIC_PATROL_RADIUS]
        epic.spec.palette is random_int of [0, 4]
        epic.spec.body_segments is 6
        epic.spec.body_shape is SHAPE_SHELL
        append of [game.epic_cells, epic]

    p_radius is player_radius of game
    pred_n is len of game.predators
    epic_n is len of game.epic_cells
    for i in range of epic_n:
        e is game.epic_cells[i]
        if e.active != 1:
            continue
        # Circular patrol
        e.angle is e.angle + EPIC_PATROL_SPEED * SIM_DT
        e.px is wrap_coord of [e.patrol_cx + (cos of e.angle) * e.patrol_radius, ww]
        e.py is wrap_coord of [e.patrol_cy + (sin of e.angle) * e.patrol_radius, wh]

        # Suction force on player
        dx is torus_delta of [gpx, e.px, ww]
        dy is torus_delta of [gpy, e.py, wh]
        dist is sqrt of (dx * dx + dy * dy)
        if dist < EPIC_SUCTION_RADIUS and dist > e.radius:
            strength is EPIC_SUCTION_FORCE / (dist * dist)
            game.vx is game.vx + (dx / dist) * strength
            game.vy is game.vy + (dy / dist) * strength

        # Suction force on predators
        for j in range of pred_n:
            pred is game.predators[j]
            if pred.active != 1:
                continue
            pdx is torus_delta of [pred.px, e.px, ww]
            pdy is torus_delta of [pred.py, e.py, wh]
            pdist is sqrt of (pdx * pdx + pdy * pdy)
            if pdist < EPIC_SUCTION_RADIUS and pdist > e.radius:
                pstr is EPIC_SUCTION_FORCE / (pdist * pdist)
                pred.vx is pred.vx + (pdx / pdist) * pstr
                pred.vy is pred.vy + (pdy / pdist) * pstr

        # Player collision — instant death
        dist_sq is torus_dist_sq of [gpx, gpy, e.px, e.py, ww, wh]
        kill_range is (p_radius + e.radius) * (p_radius + e.radius)
        if dist_sq < kill_range:
            game.game_over is 1
            game.game_over_reason is GAME_OVER_EPIC
            game.event_died is 1
            game.message is "Devoured by a leviathan"

# ============================================================
# Part drop logic
# ============================================================

define try_drop_part(game, pred) as:
    roll is random_int of [0, 99]
    if roll < PART_DROP_CHANCE:
        # Pick a part type based on predator
        type_roll is random_int of [0, 2]
        value is 0
        if type_roll == PART_TYPE_MOUTH:
            value is pred.spec.mouth_type
        elif type_roll == PART_TYPE_APPENDAGE:
            # Pick a random appendage type the pred has
            value is APPENDAGE_FIN
            for k in range of (len of pred.spec.appendages):
                if pred.spec.appendages[k] > APPENDAGE_NONE:
                    value is pred.spec.appendages[k]
                    break
        else:
            value is pred.spec.palette
        append of [game.part_drops, new_part_drop of [pred.px, pred.py, type_roll, value]]

define update_part_drops(game) as:
    p_radius is player_radius of game
    alive is []
    ww is game.world_w
    wh is game.world_h
    gpx is game.px
    gpy is game.py
    drops_n is len of game.part_drops
    for i in range of drops_n:
        pd is game.part_drops[i]
        if pd.active != 1:
            continue
        pd.lifetime is pd.lifetime - 1
        if pd.lifetime <= 0:
            pd.active is 0
            continue
        # Drift
        pd.px is wrap_coord of [pd.px + pd.vx * SIM_DT, ww]
        pd.py is wrap_coord of [pd.py + pd.vy * SIM_DT, wh]
        # Player collection
        dist_sq is torus_dist_sq of [gpx, gpy, pd.px, pd.py, ww, wh]
        collect_range is (p_radius + 0.5) * (p_radius + 0.5)
        if dist_sq < collect_range:
            pd.active is 0
            game.dna is game.dna + 5
            game.event_collect_x is pd.px
            game.event_collect_y is pd.py
            game.event_part_collect is 1
            # Unlock the collected part
            if pd.part_type == PART_TYPE_MOUTH:
                game.unlocked_mouths is bit_or of [game.unlocked_mouths, bit_shl of [1, pd.part_value]]
            elif pd.part_type == PART_TYPE_APPENDAGE:
                if pd.part_value >= 1 and pd.part_value <= 3:
                    game.unlocked_appendages is bit_or of [game.unlocked_appendages, bit_shl of [1, pd.part_value - 1]]
                elif pd.part_value >= 4 and pd.part_value <= 6:
                    game.unlocked_weapons is bit_or of [game.unlocked_weapons, bit_shl of [1, pd.part_value - 4]]
            elif pd.part_type == PART_TYPE_PALETTE:
                game.unlocked_palettes is bit_or of [game.unlocked_palettes, bit_shl of [1, pd.part_value]]
            game.message is "Part collected! +5 DNA"
            continue
        append of [alive, pd]
    game.part_drops is alive

# ============================================================
# Jet boost activation
# ============================================================

define activate_jet(game) as:
    if game.game_over == 1:
        return null
    if game.jet_cooldown > 0 or game.jet_active > 0:
        return null
    has_jet is count_appendage_type of [game.creature, APPENDAGE_JET]
    if has_jet > 0:
        game.jet_active is JET_DURATION
        game.jet_cooldown is JET_COOLDOWN_MAX
        game.thrusting is 1
        game.event_jet is 1

# ============================================================
# Poison activation (manual)
# ============================================================

define activate_poison(game) as:
    if game.game_over == 1:
        return null
    if game.poison_cooldown > 0:
        return null
    has_poison is count_appendage_type of [game.creature, APPENDAGE_POISON]
    if has_poison > 0:
        append of [game.poison_clouds, new_poison_cloud of [game.px, game.py, 1]]
        game.poison_cooldown is POISON_COOLDOWN_MAX
        game.event_poison is 1

# ============================================================
# Electric activation (manual)
# ============================================================

define activate_electric(game) as:
    if game.game_over == 1:
        return null
    if game.electric_cooldown > 0:
        return null
    has_electric is count_appendage_type of [game.creature, APPENDAGE_ELECTRIC]
    if has_electric > 0:
        best_dist is 999.0
        best_idx is -1
        for i in range of (len of game.predators):
            p is game.predators[i]
            if p.active != 1 or p.stunned_timer > 0:
                continue
            dist is torus_dist of [game.px, game.py, p.px, p.py, game.world_w, game.world_h]
            if dist < ELECTRIC_RANGE and dist < best_dist:
                best_dist is dist
                best_idx is i
        if best_idx >= 0:
            target is game.predators[best_idx]
            append of [game.electric_bolts, new_electric_bolt of [game.px, game.py, target.px, target.py]]
            target.stunned_timer is ELECTRIC_STUN_DURATION
            target.hp is target.hp - 1
            if target.hp <= 0:
                game.event_kill_x is target.px
                game.event_kill_y is target.py
                game.event_kill_palette is target.spec.palette
                game.event_killed is 1
                game.score is game.score + 10 + target.size * 3
                spawn_meat of [game.meat, target.px, target.py, 300]
                target.px is rand_range_f of [0, game.world_w]
                target.py is rand_range_f of [0, game.world_h]
                target.hp is target.size + 1
                target.vx is 0.0
                target.vy is 0.0
            game.electric_cooldown is ELECTRIC_COOLDOWN_MAX
            game.event_electric is 1

# ============================================================
# Clear per-frame events (call at start of tick)
# ============================================================

define clear_events(game) as:
    game.event_kill_x is -1.0
    game.event_kill_y is -1.0
    game.event_collision_x is -1.0
    game.event_collision_y is -1.0
    game.event_collect_x is -1.0
    game.event_collect_y is -1.0
    game.event_ate_plant is 0
    game.event_ate_meat is 0
    game.event_killed is 0
    game.event_died is 0
    game.event_mate_call is 0
    game.event_part_collect is 0
    game.event_tier_up is 0
    game.event_poison is 0
    game.event_electric is 0
    game.event_jet is 0
    game.event_player_hurt is 0

# ============================================================
# Input mapping
# ============================================================
# Apply a held-keys dict (from the event loop's polling state) onto
# the game's input fields. Call once per frame after draining events.

define apply_held_keys(game, keys) as:
    game.thrusting is keys.thrust
    game.braking is keys.brake
    if keys.left == 1:
        game.turning is -1
    elif keys.right == 1:
        game.turning is 1
    else:
        game.turning is 0

# ============================================================
# Player actions
# ============================================================
# Mutates `game` in place. Returns `game` for convenience.

define game_action(game, action) as:
    match action:
        case ACTION_THRUST:
            game.thrusting is 1
        case ACTION_BRAKE:
            game.braking is 1
        case ACTION_TURN_LEFT:
            game.turning is -1
        case ACTION_TURN_RIGHT:
            game.turning is 1
        case ACTION_BUY_SPEED:
            if game.dna >= 5:
                game.dna is game.dna - 5
                game.speed_level is game.speed_level + 1
                game.message is ""
        case ACTION_BUY_SENSE:
            if game.dna >= 5:
                game.dna is game.dna - 5
                game.sense_level is game.sense_level + 1
        case ACTION_BUY_SPIKES:
            if game.dna >= 5:
                game.dna is game.dna - 5
                game.spikes_level is game.spikes_level + 1
                game.message is ""
        case ACTION_JET:
            activate_jet of game
        case ACTION_POISON:
            activate_poison of game
        case ACTION_ELECTRIC:
            activate_electric of game
        case ACTION_CALL_MATE:
            call_mate of game
        case ACTION_EVOLVE:
            evolve_tier_up of game
    return game

# ============================================================
# Game status
# ============================================================

define game_status(game) as:
    active_pred is 0
    for i in range of (len of game.predators):
        if game.predators[i].active == 1:
            active_pred is active_pred + 1

    active_food is 0
    for i in range of (len of game.food):
        if game.food[i].active == 1:
            active_food is active_food + 1

    return {
        "tick": game.tick,
        "energy": game.energy,
        "score": game.score,
        "dna": game.dna,
        "tier": game.scale_tier,
        "food_eaten": game.food_eaten,
        "active_food": active_food,
        "active_predators": active_pred,
        "game_over": game.game_over,
        "message": game.message
    }

# ============================================================
# Autopilot — hand-coded AI decision logic
# ============================================================

define autopilot_buy_mutation(game) as:
    if game.dna <= 0:
        return 0
    if game.sense_level < 1:
        return ACTION_BUY_SENSE
    if game.spikes_level < 2:
        return ACTION_BUY_SPIKES
    if game.sense_level < 3:
        return ACTION_BUY_SENSE
    if game.speed_level < 2:
        return ACTION_BUY_SPEED
    if game.spikes_level < 4:
        return ACTION_BUY_SPIKES
    if game.speed_level < 3:
        return ACTION_BUY_SPEED
    return ACTION_BUY_SENSE

define autopilot_decide(game) as:
    sense_range is creature_sense_range of [game.creature, game.sense_level]
    my_power is creature_collision_power of [game.creature, game.spikes_level, game.mass]

    # Buy mutations when we can
    buy is autopilot_buy_mutation of game
    if buy > 0:
        game_action of [game, buy]

    # Find nearest food
    best_food_dist is 99999.0
    best_food_x is 0.0
    best_food_y is 0.0
    have_food is 0
    for i in range of (len of game.food):
        if game.food[i].active == 1:
            d is torus_dist of [game.px, game.py, game.food[i].px, game.food[i].py, game.world_w, game.world_h]
            if d < sense_range:
                if d < best_food_dist:
                    best_food_dist is d
                    best_food_x is game.food[i].px
                    best_food_y is game.food[i].py
                    have_food is 1

    # Find nearest meat
    best_meat_dist is 99999.0
    best_meat_x is 0.0
    best_meat_y is 0.0
    have_meat is 0
    for i in range of (len of game.meat):
        if game.meat[i].active == 1:
            d is torus_dist of [game.px, game.py, game.meat[i].px, game.meat[i].py, game.world_w, game.world_h]
            if d < sense_range:
                if d < best_meat_dist:
                    best_meat_dist is d
                    best_meat_x is game.meat[i].px
                    best_meat_y is game.meat[i].py
                    have_meat is 1

    # Find nearest threat (predator stronger than us)
    threat_dist is 99999.0
    threat_x is 0.0
    threat_y is 0.0
    threat_size is 0.0
    have_threat is 0
    for i in range of (len of game.predators):
        p is game.predators[i]
        if p.active == 1:
            if p.spec == null:
                continue
            d is torus_dist of [game.px, game.py, p.px, p.py, game.world_w, game.world_h]
            if d < sense_range:
                pred_power is creature_collision_power of [p.spec, 0, p.size]
                if pred_power > my_power:
                    if d < threat_dist:
                        threat_dist is d
                        threat_x is p.px
                        threat_y is p.py
                        threat_size is p.size
                        have_threat is 1

    # Find nearest huntable predator (weaker than us, for carnivores)
    hunt_dist is 99999.0
    hunt_x is 0.0
    hunt_y is 0.0
    have_hunt is 0
    if have_food == 0:
        if have_meat == 0:
            for i in range of (len of game.predators):
                p is game.predators[i]
                if p.active == 1:
                    if p.spec == null:
                        continue
                    d is torus_dist of [game.px, game.py, p.px, p.py, game.world_w, game.world_h]
                    if d < sense_range:
                        pred_power is creature_collision_power of [p.spec, 0, p.size]
                        if my_power >= pred_power:
                            if d < hunt_dist:
                                hunt_dist is d
                                hunt_x is p.px
                                hunt_y is p.py
                                have_hunt is 1

    # Pick best food target (meat if closer than plant)
    target_x is 0.0
    target_y is 0.0
    have_target is 0
    if have_meat == 1:
        if have_food == 0:
            target_x is best_meat_x
            target_y is best_meat_y
            have_target is 1
        elif best_meat_dist < best_food_dist:
            target_x is best_meat_x
            target_y is best_meat_y
            have_target is 1
        else:
            target_x is best_food_x
            target_y is best_food_y
            have_target is 1
    elif have_food == 1:
        target_x is best_food_x
        target_y is best_food_y
        have_target is 1

    # Decision: flee, seek food, hunt, or wander
    if have_threat == 1:
        if threat_dist < (6.0 + threat_size * 2.0):
            dx is torus_delta of [game.px, threat_x, game.world_w]
            dy is torus_delta of [game.py, threat_y, game.world_h]
            flee_angle is atan2 of [0.0 - dy, 0.0 - dx]
            diff is angle_diff of [game.angle, flee_angle]
            game.thrusting is 1
            game.braking is 0
            if diff > 0.1:
                game.turning is 1
            elif diff < -0.1:
                game.turning is -1
            else:
                game.turning is 0
            return null

    if have_target == 1:
        dx is torus_delta of [game.px, target_x, game.world_w]
        dy is torus_delta of [game.py, target_y, game.world_h]
        target_angle is atan2 of [dy, dx]
        diff is angle_diff of [game.angle, target_angle]
        game.thrusting is 1
        game.braking is 0
        if diff > 0.1:
            game.turning is 1
        elif diff < -0.1:
            game.turning is -1
        else:
            game.turning is 0
        return null

    if have_hunt == 1:
        dx is torus_delta of [game.px, hunt_x, game.world_w]
        dy is torus_delta of [game.py, hunt_y, game.world_h]
        hunt_angle is atan2 of [dy, dx]
        diff is angle_diff of [game.angle, hunt_angle]
        game.thrusting is 1
        game.braking is 0
        if diff > 0.1:
            game.turning is 1
        elif diff < -0.1:
            game.turning is -1
        else:
            game.turning is 0
        return null

    # Wander: thrust and occasionally turn
    game.thrusting is 1
    game.braking is 0
    if game.tick % 120 == 0:
        roll is random_int of [0, 2]
        game.turning is roll - 1
    return null

# Read current control state and return an action label (0-4)
# Call AFTER autopilot_decide to read what it decided.
define autopilot_action_label(game) as:
    if game.thrusting == 1 and game.turning == -1:
        return 2
    if game.thrusting == 1 and game.turning == 1:
        return 3
    if game.thrusting == 1:
        return 1
    if game.braking == 1:
        return 4
    return 0

# ============================================================
# Creature save / load  (format compatible with C version)
# ============================================================

define _list_to_csv(lst) as:
    out is ""
    for i in range of (len of lst):
        if i > 0:
            out is f"{out},{lst[i]}"
        else:
            out is f"{lst[i]}"
    return out

define _csv_to_list(text, count) as:
    parts is split of [text, ","]
    result is []
    for i in range of count:
        if i < (len of parts):
            append of [result, floor of (num of parts[i])]
        else:
            append of [result, 0]
    return result

define save_creature(spec) as:
    mkdir of "saves"
    lines is "version=9\n"
    lines is f"{lines}palette={spec.palette}\n"
    lines is f"{lines}body_shape={spec.body_shape}\n"
    lines is f"{lines}body_segments={spec.body_segments}\n"
    lines is f"{lines}pattern={spec.pattern}\n"
    lines is f"{lines}mouth={spec.mouth_type}\n"
    lines is f"{lines}eyes={_list_to_csv of spec.eyes}\n"
    lines is f"{lines}eye_anchors={_list_to_csv of spec.eye_anchor}\n"
    lines is f"{lines}spikes={_list_to_csv of spec.spikes}\n"
    lines is f"{lines}spike_anchors={_list_to_csv of spec.spike_anchor}\n"
    lines is f"{lines}appendages={_list_to_csv of spec.appendages}\n"
    lines is f"{lines}appendage_anchors={_list_to_csv of spec.appendage_anchor}\n"
    lines is f"{lines}spine_bend={_list_to_csv of spec.spine_bend}\n"
    write_text of ["saves/creature_profile.txt", lines]
    return 1

define load_creature(spec) as:
    if file_exists of "saves/creature_profile.txt" == 0:
        return 0
    text is read_text of "saves/creature_profile.txt"
    if (len of text) == 0:
        return 0
    lines is split of [text, "\n"]
    for i in range of (len of lines):
        line is lines[i]
        if (len of line) == 0:
            continue
        eq is -1
        for j in range of (len of line):
            if line[j] == "=":
                eq is j
                break
        if eq < 0:
            continue
        key is substr of [line, 0, eq]
        val is substr of [line, eq + 1, len of line]
        match key:
            case "palette":
                spec.palette is floor of (num of val)
            case "body_shape":
                spec.body_shape is floor of (num of val)
            case "body_segments":
                segs is floor of (num of val)
                spec.body_segments is clamp of [segs, 1, CREATURE_MAX_SEGMENTS]
            case "pattern":
                spec.pattern is floor of (num of val)
            case "mouth":
                spec.mouth_type is floor of (num of val)
            case "eyes":
                spec.eyes is _csv_to_list of [val, 14]
            case "eye_anchors":
                spec.eye_anchor is _csv_to_list of [val, 14]
            case "spikes":
                spec.spikes is _csv_to_list of [val, 14]
            case "spike_anchors":
                spec.spike_anchor is _csv_to_list of [val, 14]
            case "appendages":
                spec.appendages is _csv_to_list of [val, 14]
            case "appendage_anchors":
                spec.appendage_anchor is _csv_to_list of [val, 14]
            case "spine_bend":
                spec.spine_bend is _csv_to_list of [val, CREATURE_SPINE_JOINTS]
    return 1
